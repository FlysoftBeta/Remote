+void PrtsWindowRegistry::MaximizeAll() {
+  for (auto& [id, entry] : entries_) {
+    // Headless Maximize() is a no-op for an already maximized window. Restore
+    // first to recompute its bounds and scale from the updated work area.
+    entry->widget_->Restore();
+    entry->widget_->Maximize();
+    // Avoid DIP-to-pixel round trips adding an odd capture pixel at fractional
+    // DSF. Preserve maximized state while making the root equal monitor pixels.
+    entry->host_->SetBoundsInPixels(display::win::GetScreenWinHeadless()
+                                      ->GetPrimaryScreenWinDisplay()
+                                      .pixel_bounds());
+  }
+}
