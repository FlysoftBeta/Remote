+// PRTS: Runtime counterpart to the initial --screen-info configuration.
+// The remote-mode caller owns policy; this general screen API also works for
+// other headless embedders without depending on ui/base (which depends on us).
+void ScreenWinHeadless::SetPrimaryDisplayGeometry(const gfx::Size& dip,
+                                                float dsf) {
+  CHECK(!dip.IsEmpty());
+  CHECK(std::isfinite(dsf) && dsf >= 1.0f);
+  Display display = GetPrimaryDisplay();
+  // H.264 requires even pixel dimensions. Round down before publishing so the
+  // capture constraints, compositor and display all agree on the pixel size.
+  gfx::Size pixels(static_cast<int>(dip.width() * dsf) & ~1,
+                   static_cast<int>(dip.height() * dsf) & ~1);
+  // Keep monitor pixels exact: converting through integer DIP bounds can add
+  // an odd pixel at fractional scale factors.
+  MONITORINFOEX& monitor_info = headless_monitor_info_.at(display.id());
+  monitor_info.rcMonitor = gfx::Rect(pixels).ToRECT();
+  monitor_info.rcWork = monitor_info.rcMonitor;
+  auto infos = GetExistingDisplayInfos(/*except_display_id=*/display.id());
+  infos.emplace_back(display.id(), monitor_info, dsf,
+                     display.text_scale_multiplier(), display.color_depth(),
+                     kSdrWhiteLevel, display.rotation(), kDisplayFrequency,
+                     GetDisplayPhysicalPixelsPerInch(dsf),
+                     GetOutputTechnology(display.IsInternal()), display.label());
+  UpdateFromDisplayInfos(infos);
+}
