+#include "ui/base/ui_base_switches.h"
 #include "ui/base/win/hwnd_metrics.h"
 #include "ui/display/screen.h"
 #include "ui/display/win/screen_win.h"
@@ -305,6 +307,10 @@ void BrowserDesktopWindowTreeHostWin::Show(
       OnHostWorkspaceChanged();
     }
   }
+  // PRTS: Applies to startup, Ctrl+N and browser popup windows alike.
+  if (ui::IsPrtsRemoteMode()) {
+    show_state = ui::mojom::WindowShowState::kMaximized;
+  }
   DesktopWindowTreeHostWin::Show(show_state, restore_bounds);
 }
 
@@ -333,6 +339,12 @@ int BrowserDesktopWindowTreeHostWin::GetInitialShowState() const {
 bool BrowserDesktopWindowTreeHostWin::GetClientAreaInsets(
     gfx::Insets* insets,
     int frame_thickness) const {
+  // PRTS: Headless maximized bounds already equal the virtual work area;
+  // native resize insets would shrink the captured root on every edge.
+  if (ui::IsPrtsRemoteMode()) {
+    *insets = gfx::Insets();
+    return true;
+  }
   // Always use default insets for opaque frame.
   if (!browser_view_ || !ShouldUseNativeFrame()) {
     return false;
