diff --git a/ui/gl/prts_fake_vsync_clock.h b/ui/gl/prts_fake_vsync_clock.h
new file mode 100644
index 0000000000..3ec840765e
--- /dev/null
+++ b/ui/gl/prts_fake_vsync_clock.h
@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_GL_PRTS_FAKE_VSYNC_CLOCK_H_
+#define UI_GL_PRTS_FAKE_VSYNC_CLOCK_H_
+
+#include <windows.h>
+
+#include "base/time/time.h"
+#include "base/win/scoped_handle.h"
+
+namespace prts {
+
+// PRTS: Drift-free pacing for --fake-vsync-rate. The stock path does
+// Sleep(ceil(interval_ms)): 60 Hz becomes 17 ms plus loop/timer overhead,
+// which measured ~19 ms (52.7 Hz) in the cloaked-window case where no DXGI
+// output matches. This waits for absolute deadlines on a high-resolution
+// waitable timer instead. Only used on the vsync thread.
+class PrtsFakeVSyncClock {
+ public:
+  PrtsFakeVSyncClock();
+  ~PrtsFakeVSyncClock();
+
+  void WaitForNextTick(base::TimeDelta interval) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    base::TimeTicks target = last_tick_ + interval;
+    if (last_tick_.is_null() || now - target > interval) {
+      // First tick or long idle (no observers): resynchronise.
+      target = now + interval;
+    }
+    last_tick_ = target;
+    const base::TimeDelta delay = target - now;
+    if (!delay.is_positive()) {
+      return;  // Slightly late: fire immediately, stay on the grid.
+    }
+    if (!timer_.is_valid()) {
+      timer_.Set(::CreateWaitableTimerExW(nullptr, nullptr,
+                                          CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                          TIMER_ALL_ACCESS));
+    }
+    LARGE_INTEGER due;
+    due.QuadPart = -delay.InMicroseconds() * 10;  // 100 ns units, relative.
+    if (timer_.is_valid() &&
+        ::SetWaitableTimer(timer_.get(), &due, 0, nullptr, nullptr, FALSE)) {
+      ::WaitForSingleObject(timer_.get(), INFINITE);
+    } else {
+      ::Sleep(static_cast<DWORD>(delay.InMillisecondsRoundedUp()));
+    }
+  }
+
+ private:
+  base::win::ScopedHandle timer_;
+  base::TimeTicks last_tick_;
+};
+
+inline PrtsFakeVSyncClock::PrtsFakeVSyncClock() = default;
+inline PrtsFakeVSyncClock::~PrtsFakeVSyncClock() = default;
+
+}  // namespace prts
+
+#endif  // UI_GL_PRTS_FAKE_VSYNC_CLOCK_H_
