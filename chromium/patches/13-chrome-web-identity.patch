From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Mon, 26 Oct 2026 13:44:18 +0800
Subject: [PATCH] prts: web identity Google Chrome in remote mode

Patch-Name: 13-chrome-web-identity

diff --git a/chrome/browser/headless/test/headless_mode_browsertest.cc b/chrome/browser/headless/test/headless_mode_browsertest.cc
index af282d316c..81664cedb2 100644
--- a/chrome/browser/headless/test/headless_mode_browsertest.cc
+++ b/chrome/browser/headless/test/headless_mode_browsertest.cc
@@ -65,6 +65,8 @@
 #include "ui/base/clipboard/scoped_clipboard_writer.h"
 #include "ui/base/clipboard/test/clipboard_test_util.h"
 #include "ui/base/models/dialog_model.h"
+// PRTS: Shared runtime guard for the request-header expectation.
+#include "ui/base/ui_base_switches.h"
 #include "ui/display/display_switches.h"
 #include "ui/gfx/native_ui_types.h"
 #include "ui/gfx/switches.h"
@@ -345,7 +347,14 @@ IN_PROC_BROWSER_TEST_F(HeadlessModeUserAgentBrowserTest, UserAgentHasHeadless) {
 
   FlushPostedTasks();
 
-  EXPECT_THAT(headers_.at("User-Agent"), testing::HasSubstr("HeadlessChrome/"));
+  // PRTS: Verify both remote and ordinary headless request identity.
+  if (ui::IsPrtsRemoteMode()) {
+    EXPECT_THAT(headers_.at("User-Agent"), testing::HasSubstr(" Chrome/"));
+    EXPECT_THAT(headers_.at("User-Agent"),
+                testing::Not(testing::HasSubstr("HeadlessChrome/")));
+  } else {
+    EXPECT_THAT(headers_.at("User-Agent"), testing::HasSubstr("HeadlessChrome/"));
+  }
 }
 
 // Incognito mode tests ------------------------------------------------------
diff --git a/components/embedder_support/BUILD.gn b/components/embedder_support/BUILD.gn
index 4fcfc8913e..ab4ff27274 100644
--- a/components/embedder_support/BUILD.gn
+++ b/components/embedder_support/BUILD.gn
@@ -95,6 +95,8 @@ source_set("unit_tests") {
     "//third_party/blink/public/common:headers",
     "//third_party/blink/public/mojom:mojom_platform_headers",
     "//third_party/re2",
+    # PRTS: Runtime guard used by identity test expectations.
+    "//ui/base",
   ]
 
   if (is_android) {
diff --git a/components/embedder_support/user_agent_utils.cc b/components/embedder_support/user_agent_utils.cc
index bf4a8960a0..00c513954b 100644
--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -30,6 +30,8 @@
 #include "net/http/http_util.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+// PRTS: Use the shared runtime guard; this target already depends on //ui/base.
+#include "ui/base/ui_base_switches.h"
 
 #if BUILDFLAG(IS_WIN)
 #include <windows.h>
@@ -162,6 +164,10 @@ const blink::UserAgentBrandList GetUserAgentBrandList(
 #if !BUILDFLAG(CHROMIUM_BRANDING)
   brand = version_info::GetProductName();
 #endif
+  // PRTS: Keep the common GREASE and major/full-version generation unchanged.
+  if (ui::IsPrtsRemoteMode()) {
+    brand = "Google Chrome";
+  }
 
   std::string brand_version =
       output_version_type == blink::UserAgentBrandVersionType::kFullVersion
@@ -446,7 +452,9 @@ std::string BuildUserAgentFromProduct(const std::string& product) {
 // depending on the Reduce User-Agent reduction phase features.
 std::string GetUserAgentInternal() {
   std::string product = GetProductAndVersion();
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
+  // PRTS: Remote Chrome uses the ordinary Chrome product token in headless mode.
+  if (!ui::IsPrtsRemoteMode() &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
     product.insert(0, "Headless");
   }
 
diff --git a/components/embedder_support/user_agent_utils_unittest.cc b/components/embedder_support/user_agent_utils_unittest.cc
index 23fa11bc9e..7860449175 100644
--- a/components/embedder_support/user_agent_utils_unittest.cc
+++ b/components/embedder_support/user_agent_utils_unittest.cc
@@ -27,6 +27,8 @@
 #include "third_party/blink/public/common/user_agent/user_agent_brand_version_type.h"
 #include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
 #include "third_party/re2/src/re2/re2.h"
+// PRTS: Expectations follow the process-wide remote switch.
+#include "ui/base/ui_base_switches.h"
 
 #if BUILDFLAG(IS_IOS)
 #include "ui/base/device_form_factor.h"
@@ -307,13 +309,21 @@ TEST_F(UserAgentUtilsTest, UserAgentMetadata) {
 
   // According to spec, Sec-CH-UA should contain what project the browser is
   // based on (i.e. Chromium in this case) as well as the actual product.
-  // In CHROMIUM_BRANDING builds this will check chromium twice. That should be
-  // ok though.
+  // PRTS: Chromium builds omit the product brand even when BRANDING says PRTS.
+  std::string expected_product_brand = "Chromium";
+#if !BUILDFLAG(CHROMIUM_BRANDING)
+  expected_product_brand = version_info::GetProductName();
+#endif
+  if (ui::IsPrtsRemoteMode()) {
+    expected_product_brand = "Google Chrome";
+    EXPECT_EQ(metadata.brand_version_list.size(), 3u);
+    EXPECT_EQ(metadata.brand_full_version_list.size(), 3u);
+  }
 
   const blink::UserAgentBrandVersion chromium_brand_version = {"Chromium",
                                                                major_version};
   const blink::UserAgentBrandVersion product_brand_version = {
-      std::string(version_info::GetProductName()), major_version};
+      expected_product_brand, major_version};
 
   EXPECT_TRUE(ContainsBrandVersion(metadata.brand_version_list,
                                    chromium_brand_version));
@@ -324,7 +334,7 @@ TEST_F(UserAgentUtilsTest, UserAgentMetadata) {
   const blink::UserAgentBrandVersion chromium_brand_full_version = {
       "Chromium", full_version};
   const blink::UserAgentBrandVersion product_brand_full_version = {
-      std::string(version_info::GetProductName()), full_version};
+      expected_product_brand, full_version};
 
   EXPECT_TRUE(ContainsBrandVersion(metadata.brand_full_version_list,
                                    chromium_brand_full_version));
@@ -701,8 +711,14 @@ TEST_F(UserAgentUtilsTest, HeadlessUserAgent) {
   command_line->AppendSwitch(kHeadless);
   ASSERT_TRUE(command_line->HasSwitch(kHeadless));
 
-  // In headless mode product name should have the Headless prefix.
-  EXPECT_THAT(GetUserAgent(), testing::HasSubstr("HeadlessChrome/"));
+  // PRTS: Run with and without --prts-remote in separate processes.
+  if (ui::IsPrtsRemoteMode()) {
+    EXPECT_THAT(GetUserAgent(), testing::HasSubstr(" Chrome/"));
+    EXPECT_THAT(GetUserAgent(),
+                testing::Not(testing::HasSubstr("HeadlessChrome/")));
+  } else {
+    EXPECT_THAT(GetUserAgent(), testing::HasSubstr("HeadlessChrome/"));
+  }
 }
 
 namespace {
