diff --git a/ui/base/ime/init/input_method_factory.cc b/ui/base/ime/init/input_method_factory.cc
index ad27a262b3..d7841182c1 100644
--- a/ui/base/ime/init/input_method_factory.cc
+++ b/ui/base/ime/init/input_method_factory.cc
@@ -9,6 +9,9 @@
 #include "base/memory/ptr_util.h"
 #include "build/build_config.h"
 #include "ui/base/ime/mock_input_method.h"
+// PRTS: use the remote IME before the ordinary headless mock branch.
+#include "ui/base/ime/remote_input_method.h"
+#include "ui/base/ui_base_switches.h"
 #include "ui/base/ui_base_features.h"
 #include "ui/gfx/switches.h"
 
@@ -49,6 +52,10 @@ std::unique_ptr<InputMethod> CreateInputMethod(
   if (g_input_method_set_for_testing)
     return std::make_unique<MockInputMethod>(ime_key_event_dispatcher);
 
+  // PRTS: retain testing overrides above, and opt in only for remote mode.
+  if (ui::IsPrtsRemoteMode())
+    return std::make_unique<RemoteInputMethod>(ime_key_event_dispatcher);
+
   if (base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kHeadless))
     return base::WrapUnique(new MockInputMethod(ime_key_event_dispatcher));
 
diff --git a/ui/base/ime/remote_input_method.cc b/ui/base/ime/remote_input_method.cc
new file mode 100644
index 0000000000..1d3e15964d
--- /dev/null
+++ b/ui/base/ime/remote_input_method.cc
@@ -0,0 +1,165 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "ui/base/ime/remote_input_method.h"
+
+#include <utility>
+
+#include "base/observer_list.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/base/ime/virtual_keyboard_controller.h"
+#include "ui/base/ime/virtual_keyboard_controller_observer.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace ui {
+class RemoteInputMethod::KeyboardController : public VirtualKeyboardController {
+ public:
+  bool DisplayVirtualKeyboard() override {
+    visible_ = true;
+    auto callback = callback_;
+    observers_.Notify(&VirtualKeyboardControllerObserver::OnKeyboardVisible,
+                      gfx::Rect());
+    if (callback) {
+      callback.Run(true);
+    }
+    return true;
+  }
+  void DismissVirtualKeyboard() override {
+    visible_ = false;
+    auto callback = callback_;
+    observers_.Notify(&VirtualKeyboardControllerObserver::OnKeyboardHidden);
+    if (callback) {
+      callback.Run(false);
+    }
+  }
+  bool IsKeyboardVisible() override { return visible_; }
+  void AddObserver(VirtualKeyboardControllerObserver* observer) override {
+    observers_.AddObserver(observer);
+  }
+  void RemoveObserver(VirtualKeyboardControllerObserver* observer) override {
+    observers_.RemoveObserver(observer);
+  }
+  void SetCallback(base::RepeatingCallback<void(bool)> callback) {
+    callback_ = std::move(callback);
+  }
+
+ private:
+  bool visible_ = false;
+  base::RepeatingCallback<void(bool)> callback_;
+  base::ObserverList<VirtualKeyboardControllerObserver> observers_;
+};
+
+RemoteInputMethod::RemoteInputMethod(ImeKeyEventDispatcher* dispatcher)
+    : MockInputMethod(dispatcher),
+      controller_(std::make_unique<KeyboardController>()) {}
+RemoteInputMethod::~RemoteInputMethod() = default;
+
+void RemoteInputMethod::SetVirtualKeyboardCallback(
+    base::RepeatingCallback<void(bool)> callback) {
+  controller_->SetCallback(std::move(callback));
+}
+
+void RemoteInputMethod::SetFocusedTextInputClient(TextInputClient* client) {
+  if (GetTextInputClient() == client) {
+    return;
+  }
+  MockInputMethod::SetFocusedTextInputClient(client);
+  // MockInputMethod notifies for non-null clients only.
+  if (!client) {
+    OnTextInputTypeChanged(nullptr);
+  }
+}
+
+void RemoteInputMethod::SetCompositionCancelledCallback(
+    base::RepeatingClosure callback) {
+  composition_cancelled_ = std::move(callback);
+}
+
+void RemoteInputMethod::CancelComposition(const TextInputClient* client) {
+  // PRTS: this class is selected only by the guarded remote-mode factory.
+  // The renderer may already have changed its active node. Notify the remote
+  // editor without clearing composition on a possibly different client.
+  if (client == GetTextInputClient() && composition_cancelled_) {
+    auto callback = composition_cancelled_;
+    callback.Run();
+  }
+}
+
+void RemoteInputMethod::DetachTextInputClient(TextInputClient* client) {
+  if (!client || GetTextInputClient() != client) {
+    return;
+  }
+  MockInputMethod::DetachTextInputClient(client);
+  OnTextInputTypeChanged(nullptr);
+}
+
+void RemoteInputMethod::OnTextInputTypeChanged(TextInputClient* client) {
+  if (client != GetTextInputClient()) {
+    return;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  MockInputMethod::OnTextInputTypeChanged(client);
+  if (!weak_this) {
+    return;
+  }
+  client = GetTextInputClient();
+  if (!client || client->GetTextInputType() == TEXT_INPUT_TYPE_NONE ||
+      client->GetTextInputMode() == TEXT_INPUT_MODE_NONE) {
+    controller_->DismissVirtualKeyboard();
+  }
+}
+void RemoteInputMethod::OnCaretBoundsChanged(const TextInputClient* client) {
+  if (client == GetTextInputClient()) {
+    MockInputMethod::OnCaretBoundsChanged(client);
+  }
+}
+TextInputType RemoteInputMethod::GetTextInputType() const {
+  auto* client = GetTextInputClient();
+  return client ? client->GetTextInputType() : TEXT_INPUT_TYPE_NONE;
+}
+
+EventDispatchDetails RemoteInputMethod::DispatchKeyEvent(KeyEvent* event) {
+  auto weak_this = weak_factory_.GetWeakPtr();
+  auto client =
+      GetTextInputClient() ? GetTextInputClient()->AsWeakPtr() : nullptr;
+  auto details = MockInputMethod::DispatchKeyEvent(event);
+  // Same InsertChar contract as InputMethodMinimal, with reentrancy checks.
+  // Content marks raw keydowns handled; only stopped propagation suppresses
+  // Char.
+  if (!weak_this || details.dispatcher_destroyed || details.target_destroyed) {
+    return details;
+  }
+  if (client && client.get() == GetTextInputClient() &&
+      !event->stopped_propagation() &&
+      event->type() == EventType::kKeyPressed && !event->is_char() &&
+      event->key_code() != VKEY_PROCESSKEY && event->GetCharacter()) {
+    client->InsertChar(*event);
+    event->StopPropagation();
+  }
+  return details;
+}
+
+void RemoteInputMethod::OnBlur() {
+  auto weak_this = weak_factory_.GetWeakPtr();
+  MockInputMethod::OnBlur();
+  if (weak_this) {
+    controller_->DismissVirtualKeyboard();
+  }
+}
+void RemoteInputMethod::SetVirtualKeyboardVisibilityIfEnabled(bool show) {
+  auto weak_this = weak_factory_.GetWeakPtr();
+  MockInputMethod::SetVirtualKeyboardVisibilityIfEnabled(show);
+  if (!weak_this) {
+    return;
+  }
+  if (show) {
+    controller_->DisplayVirtualKeyboard();
+  } else {
+    controller_->DismissVirtualKeyboard();
+  }
+}
+VirtualKeyboardController* RemoteInputMethod::GetVirtualKeyboardController() {
+  return controller_.get();
+}
+}  // namespace ui
