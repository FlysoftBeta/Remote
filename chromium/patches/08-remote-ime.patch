@@ -0,0 +1,41 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef UI_BASE_IME_REMOTE_INPUT_METHOD_H_
+#define UI_BASE_IME_REMOTE_INPUT_METHOD_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/ime/mock_input_method.h"
+
+namespace ui {
+// UI-sequence-only IME for injected input. No native IME or OS keyboard calls.
+class COMPONENT_EXPORT(UI_BASE_IME) RemoteInputMethod : public MockInputMethod {
+ public:
+  explicit RemoteInputMethod(ImeKeyEventDispatcher* dispatcher);
+  ~RemoteInputMethod() override;
+
+  // One active-root bridge installs this callback; clear it before detaching.
+  void SetVirtualKeyboardCallback(base::RepeatingCallback<void(bool)> callback);
+  void SetCompositionCancelledCallback(base::RepeatingClosure callback);
+  void CancelComposition(const TextInputClient* client) override;
+  void SetFocusedTextInputClient(TextInputClient* client) override;
+  void DetachTextInputClient(TextInputClient* client) override;
+  void OnTextInputTypeChanged(TextInputClient* client) override;
+  void OnCaretBoundsChanged(const TextInputClient* client) override;
+  TextInputType GetTextInputType() const override;
+  EventDispatchDetails DispatchKeyEvent(KeyEvent* event) override;
+  void OnBlur() override;
+  void SetVirtualKeyboardVisibilityIfEnabled(bool show) override;
+  VirtualKeyboardController* GetVirtualKeyboardController() override;
+
+ private:
+  class KeyboardController;
+  std::unique_ptr<KeyboardController> controller_;
+  base::RepeatingClosure composition_cancelled_;
+  base::WeakPtrFactory<RemoteInputMethod> weak_factory_{this};
+};
+}  // namespace ui
+#endif  // UI_BASE_IME_REMOTE_INPUT_METHOD_H_
