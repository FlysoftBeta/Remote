+namespace prts {
+namespace {
+
+using FrameCallbacks = viz::mojom::FrameSinkVideoConsumerFrameCallbacks;
+
+// Constructed, bound and destroyed on frame_runner_, never on the UI thread.
+class FrameConsumer final : public viz::mojom::FrameSinkVideoConsumer {
+ public:
+  FrameConsumer(
+      mojo::PendingReceiver<viz::mojom::FrameSinkVideoConsumer> receiver,
+      mojo::PendingRemote<mojom::PrtsFrameSink> sink,
+      gfx::Size size,
+      base::OnceClosure stop)
+      : receiver_(this, std::move(receiver)),
+        sink_(std::move(sink)),
+        size_(size),
+        stop_(std::move(stop)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&FrameConsumer::Disconnected, base::Unretained(this)));
+    sink_.set_disconnect_handler(
+        base::BindOnce(&FrameConsumer::Disconnected, base::Unretained(this)));
+    sink_->Reset();
+  }
+  ~FrameConsumer() override { Shutdown(); }
+
+  void SetSize(gfx::Size size) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (size_ != size) {
+      size_ = size;
+      buffers_.clear();
+      if (sink_) {
+        sink_->Reset();
+      }
+    }
+  }
+
+  void OnFrameCaptured(media::mojom::VideoBufferHandlePtr data,
+                       media::mojom::VideoFrameInfoPtr info,
+                       const gfx::Rect& content_rect,
+                       mojo::PendingRemote<FrameCallbacks> callbacks) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (captured_++ % 300 == 0) {
+      LOG(INFO) << "PRTS: captured frame #" << captured_
+                << (data && data->is_gpu_memory_buffer_handle() ? " gmb"
+                                                                 : " other");
+    }
+    mojo::Remote<FrameCallbacks> lease(std::move(callbacks));
+    // Moving the Remote into the reply closure retains the Viz lease until
+    // endpoint completion. Disconnect/teardown also runs Done() via the
+    // wrapper.
+    base::ScopedClosureRunner done(base::BindOnce(
+        [](mojo::Remote<FrameCallbacks> lease) { lease->Done(); },
+        std::move(lease)));
+    if (!sink_ || !info || !data) {
+      return;
+    }
+    if (!data->is_gpu_memory_buffer_handle() ||
+        data->get_gpu_memory_buffer_handle().type != gfx::DXGI_SHARED_HANDLE) {
+      if (!warned_software_) {
+        LOG(WARNING) << "PRTS: dropping non-DXGI capture buffers; CPU fallback "
+                        "is not implemented in M1";
+        warned_software_ = true;
+      }
+      return;
+    }
+    // Discard old-size or letterboxed frames while Viz applies new constraints.
+    if (info->pixel_format != media::PIXEL_FORMAT_ARGB ||
+        info->coded_size != size_ || info->visible_rect != gfx::Rect(size_) ||
+        content_rect != gfx::Rect(size_) ||
+        (info->metadata.source_size && *info->metadata.source_size != size_)) {
+      return;
+    }
+    const auto& dxgi = data->get_gpu_memory_buffer_handle().dxgi_handle();
+    if (!dxgi.IsValid()) {
+      return;
+    }
+    auto it = buffers_.find(dxgi.token());
+    if (it == buffers_.end()) {
+      HANDLE duplicate = nullptr;
+      // Duplicate locally; Mojo's platform-handle transport duplicates this
+      // owned NT handle into the endpoint process. Never send a HANDLE integer.
+      if (!::DuplicateHandle(::GetCurrentProcess(), dxgi.buffer_handle(),
+                             ::GetCurrentProcess(), &duplicate, 0, FALSE,
+                             DUPLICATE_SAME_ACCESS)) {
+        PLOG(ERROR) << "PRTS: DuplicateHandle for captured texture";
+        return;
+      }
+      CHECK_NE(next_buffer_id_, 0u);
+      const uint32_t id = next_buffer_id_++;
+      mojo::PlatformHandle texture{base::win::ScopedHandle(duplicate)};
+      if (!texture.is_valid()) {
+        return;
+      }
+      it = buffers_.emplace(dxgi.token(), id).first;
+      sink_->NewBuffer(id, std::move(texture), info->coded_size);
+    }
+    auto frame = mojom::FrameInfo::New();
+    frame->buffer_id = it->second;
+    frame->frame_seq = ++frame_seq_;
+    frame->coded_size = info->coded_size;
+    frame->visible_rect = info->visible_rect;
+    frame->content_rect = content_rect;
+    frame->capture_begin =
+        info->metadata.capture_begin_time.value_or(base::TimeTicks());
+    frame->capture_end =
+        info->metadata.capture_end_time.value_or(base::TimeTicks());
+    frame->reference_time =
+        info->metadata.reference_time.value_or(base::TimeTicks());
+    sink_->OnFrame(std::move(frame),
+                   mojo::WrapCallbackWithDefaultInvokeIfNotRun(done.Release()));
+  }
+  void OnNewCaptureVersion(const media::CaptureVersion& version) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override {
+    LOG(INFO) << "PRTS: capturer stopped";
+    Disconnected();
+  }
+  void OnLog(const std::string& message) override {
+    LOG(INFO) << "PRTS Viz: " << message;
+  }
+
+ private:
+  void Shutdown() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    receiver_.reset();
+    if (sink_) {
+      sink_->Reset();
+      sink_.reset();  // Drops reply closures, explicitly returning every lease.
+    }
+    buffers_.clear();
+  }
+  void Disconnected() {
+    Shutdown();
+    if (stop_) {
+      // A BindPostTask closure; only control goes to UI.
+      std::move(stop_).Run();
+    }
+  }
+
+  mojo::Receiver<viz::mojom::FrameSinkVideoConsumer> receiver_;
+  mojo::Remote<mojom::PrtsFrameSink> sink_;
+  gfx::Size size_;
+  base::OnceClosure stop_;
+  std::map<gfx::DXGIHandleToken, uint32_t> buffers_;
+  uint32_t next_buffer_id_ = 1;
+  uint64_t frame_seq_ = 0;
+  uint64_t captured_ = 0;
+  bool warned_software_ = false;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace
+
+void FillPrtsGpuHelloInfo(mojom::HelloInfo& info) {
+  info.gpu_luid = 0;
+  info.software_compositing = true;
+  if (!content::GpuDataManager::Initialized()) {
+    return;
+  }
+  auto* manager = content::GpuDataManager::GetInstance();
+  if (!manager->IsEssentialGpuInfoAvailable()) {
+    // GPU info arrives asynchronously after startup; assume hardware unless
+    // acceleration is disabled. The endpoint then uses the default adapter.
+    info.software_compositing = !manager->HardwareAccelerationEnabled();
+    return;
+  }
+  const gpu::GPUInfo gpu = manager->GetGPUInfo();
+  const auto& active = gpu.active_gpu();
+  info.software_compositing = !manager->HardwareAccelerationEnabled() ||
+                              gpu.UsesSwiftShader() ||
+                              active.IsSoftwareRenderer();
+  if (!info.software_compositing) {
+    info.gpu_luid =
+        (static_cast<uint64_t>(static_cast<uint32_t>(active.luid.HighPart))
+         << 32) |
+        static_cast<uint64_t>(active.luid.LowPart);
+  }
+}
+
+class PrtsCapture::Session {
+ public:
+  Session(aura::WindowTreeHost* host,
+          uint32_t fps,
+          uint64_t generation,
+          scoped_refptr<base::SequencedTaskRunner> frame_runner,
+          mojo::PendingRemote<mojom::PrtsFrameSink> sink,
+          base::OnceClosure stopped,
+          bool software)
+      : generation_(generation),
+        size_(host->GetBoundsInPixels().size()),
+        capture_lock_(host->CreateVideoCaptureLock()) {
+    mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumer> consumer;
+    consumer_.emplace(
+        frame_runner, consumer.InitWithNewPipeAndPassReceiver(),
+        std::move(sink), size_,
+        base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                           std::move(stopped)));
+    auto* compositor = host->compositor();
+    compositor->context_factory()
+        ->GetHostFrameSinkManager()
+        ->CreateVideoCapturer(capturer_.BindNewPipeAndPassReceiver());
+    capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    capturer_->SetMinCapturePeriod(base::Seconds(1) / fps);
+    capturer_->SetMinSizeChangePeriod(base::TimeDelta());
+    capturer_->SetAutoThrottlingEnabled(false);
+    capturer_->SetAnimationFpsLockIn(false, 0.0f);
+    capturer_->SetResolutionConstraints(size_, size_, true);
+    capturer_->ChangeTarget(
+        viz::VideoCaptureTarget(compositor->frame_sink_id()), 0);
+    capturer_->Start(
+        std::move(consumer),
+        software
+            ? viz::mojom::BufferFormatPreference::kDefault
+            : viz::mojom::BufferFormatPreference::kPreferMappableSharedImage);
+  }
+  ~Session() {
+    capturer_->Stop();
+    capturer_.reset();
+    consumer_.Reset();
+  }
+  void Resize(const gfx::Size& size) {
+    if (size == size_) {
+      return;
+    }
+    size_ = size;
+    consumer_.AsyncCall(&FrameConsumer::SetSize).WithArgs(size);
+    if (!size.IsEmpty()) {
+      capturer_->SetResolutionConstraints(size, size, true);
+      capturer_->RequestRefreshFrame();
+    }
+  }
+
+  const uint64_t generation_;
+  mojo::Remote<viz::mojom::FrameSinkVideoCapturer> capturer_;
+
+ private:
+  gfx::Size size_;
+  std::unique_ptr<aura::WindowTreeHost::VideoCaptureLock> capture_lock_;
+  base::SequenceBound<FrameConsumer> consumer_;
+};
+
+PrtsCapture::PrtsCapture(PrtsWindowRegistry* registry)
+    : registry_(registry),
+      frame_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  registry_->AddObserver(this);
+}
+PrtsCapture::~PrtsCapture() {
+  StopAll();
+  registry_->RemoveObserver(this);
+}
+void PrtsCapture::FillHelloInfo(mojom::HelloInfo& info) {
+  FillPrtsGpuHelloInfo(info);
+}
+void PrtsCapture::StartCapture(uint32_t id,
+                               mojom::CaptureParamsPtr params,
+                               mojo::PendingRemote<mojom::PrtsFrameSink> sink) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  StopCapture(id);
+  auto* host = registry_->GetHost(id);
+  if (!ui::IsPrtsRemoteMode() || !host || !host->compositor() ||
+      host->GetBoundsInPixels().size().IsEmpty() || !params ||
+      !sink.is_valid()) {
+    return;
+  }
+  LOG(INFO) << "PRTS: StartCapture window=" << id << " size="
+            << host->GetBoundsInPixels().size().ToString();
+  if (params->nv12) {
+    LOG(WARNING) << "PRTS: M1 supports only ARGB capture";
+    return;
+  }
+  uint32_t fps = params->max_fps ? params->max_fps : 60;
+  const auto fps_override =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kPrtsCaptureFps);
+  unsigned override_fps = 0;
+  if (base::StringToUint(fps_override, &override_fps) && override_fps) {
+    fps = override_fps;
+  }
+  fps = std::clamp(fps, 1u, 120u);
+  const uint64_t generation = next_generation_++;
+  auto stopped = base::BindRepeating(
+      &PrtsCapture::StopIfCurrent, weak_factory_.GetWeakPtr(), id, generation);
+  auto hello = mojom::HelloInfo::New();
+  FillHelloInfo(*hello);
+  auto session = std::make_unique<Session>(host, fps, generation, frame_runner_,
+                                           std::move(sink), stopped,
+                                           hello->software_compositing);
+  session->capturer_.set_disconnect_handler(stopped);
+  sessions_.emplace(id, std::move(session));
+}
+void PrtsCapture::StopCapture(uint32_t id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  sessions_.erase(id);
+}
+void PrtsCapture::StopAll() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  sessions_.clear();
+}
+void PrtsCapture::RequestRefreshFrame(uint32_t id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto it = sessions_.find(id);
+  if (it != sessions_.end()) {
+    it->second->capturer_->RequestRefreshFrame();
+  }
+}
+void PrtsCapture::OnPrtsWindowChanged(uint32_t id) {
+  auto it = sessions_.find(id);
+  auto* host = registry_->GetHost(id);
+  if (it != sessions_.end() && host) {
+    it->second->Resize(host->GetBoundsInPixels().size());
+  }
+}
+void PrtsCapture::OnPrtsWindowRemoving(uint32_t id) {
+  StopCapture(id);
+}
+void PrtsCapture::StopIfCurrent(uint32_t id, uint64_t generation) {
+  auto it = sessions_.find(id);
+  if (it != sessions_.end() && it->second->generation_ == generation) {
+    StopCapture(id);
+  }
+}
+
+}  // namespace prts
