+// PRTS: Bind after startup has established the browser UI and Mojo IPC support.
+#if BUILDFLAG(IS_WIN)
+void ChromeBrowserMainExtraPartsHeadless::PostBrowserStart() {
+  if (ui::IsPrtsRemoteMode()) {
+    prts_controller_ = std::make_unique<prts::PrtsController>();
+    if (!prts_controller_->Start()) {
+      prts_controller_.reset();
+    }
+  }
+}
+
+// PRTS: Drop bindings and delegates before browser shutdown destroys services.
