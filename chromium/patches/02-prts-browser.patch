+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_PRTS_PRTS_IME_BRIDGE_H_
+#define CHROME_BROWSER_PRTS_PRTS_IME_BRIDGE_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/prts/mojom/prts.mojom.h"
+#include "ui/base/ime/input_method_observer.h"
+
+namespace aura {
+class WindowTreeHost;
+}
+namespace ui {
+class RemoteInputMethod;
+class TextInputClient;
+}  // namespace ui
+namespace prts {
+// UI sequence only. One observer of the active root, shared by Views and
+// content. Call SetActiveHost(nullptr) before registry teardown. Callback sinks
+// normally forward to PrtsBrowserClient; seq is session-wide, not reset on host
+// switches.
+class PrtsImeBridge : public ui::InputMethodObserver {
+ public:
+  using StateCallback = base::RepeatingCallback<void(mojom::ImeStatePtr)>;
+  using KeyboardCallback = base::RepeatingCallback<void(bool, uint32_t)>;
+  PrtsImeBridge(StateCallback state, KeyboardCallback keyboard);
+  ~PrtsImeBridge() override;
+  void SetActiveHost(aura::WindowTreeHost* host);
+  void ImeCommit(const std::string& text);
+  void ImeCompose(const std::string& text, int32_t cursor);
+  void ImeDelete(int32_t before, int32_t after);
+
+  void OnFocus() override;
+  void OnBlur() override;
+  void OnCaretBoundsChanged(const ui::TextInputClient* client) override;
+  void OnTextInputStateChanged(const ui::TextInputClient* client) override;
+  void OnInputMethodDestroyed(const ui::InputMethod* input_method) override;
+
+ private:
+  ui::TextInputClient* EditableClient() const;
+  void Publish();
+  void OnKeyboard(bool show);
+  StateCallback state_callback_;
+  KeyboardCallback keyboard_callback_;
+  base::WeakPtr<aura::WindowTreeHost> host_;
+  raw_ptr<ui::RemoteInputMethod> input_method_ = nullptr;
+  bool focused_ = false;
+  uint32_t seq_ = 0;
+  base::WeakPtrFactory<PrtsImeBridge> weak_factory_{this};
+};
+}  // namespace prts
+#endif  // CHROME_BROWSER_PRTS_PRTS_IME_BRIDGE_H_
