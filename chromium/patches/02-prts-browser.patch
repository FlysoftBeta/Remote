+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prts/prts_link.h"
+
+#include <windows.h>
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/prts/prts_switches.h"
+#include "content/public/browser/browser_thread.h"
+#include "mojo/public/cpp/platform/platform_channel.h"
+#include "mojo/public/cpp/system/invitation.h"
+#include "ui/base/ui_base_switches.h"
+
+namespace prts {
+
+PrtsLink::PrtsLink(mojom::PrtsBrowser* browser, base::OnceClosure disconnected)
+    : receiver_(browser), disconnected_(std::move(disconnected)) {}
+PrtsLink::~PrtsLink() = default;
+
+bool PrtsLink::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (started_ || !ui::IsPrtsRemoteMode() ||
+      !command_line->HasSwitch(switches::kPrtsMojo)) {
+    return false;
+  }
+  auto endpoint = mojo::PlatformChannel::RecoverPassedEndpointFromString(
+      command_line->GetSwitchValueASCII(switches::kPrtsMojo));
+  command_line->RemoveSwitch(switches::kPrtsMojo);
+  if (!endpoint.is_valid() ||
+      !::SetHandleInformation(endpoint.platform_handle().GetHandle().get(),
+                              HANDLE_FLAG_INHERIT, 0)) {
+    LOG(ERROR) << "PRTS: invalid inherited Mojo endpoint";
+    return false;
+  }
+  started_ = true;
+  return base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&mojo::IncomingInvitation::AcceptIsolated,
+                     std::move(endpoint)),
+      base::BindOnce(&PrtsLink::Bind, weak_factory_.GetWeakPtr()));
+}
+
+void PrtsLink::Bind(mojo::ScopedMessagePipeHandle pipe) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!pipe.is_valid()) {
+    Close();
+    return;
+  }
+  receiver_.Bind(mojo::PendingReceiver<mojom::PrtsBrowser>(std::move(pipe)));
+  receiver_.set_disconnect_handler(
+      base::BindOnce(&PrtsLink::Close, weak_factory_.GetWeakPtr()));
+}
+
+bool PrtsLink::SetClient(mojo::PendingRemote<mojom::PrtsBrowserClient> client) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!client.is_valid() || client_.is_bound()) {
+    return false;
+  }
+  client_.Bind(std::move(client));
+  client_.set_disconnect_handler(
+      base::BindOnce(&PrtsLink::Close, weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void PrtsLink::Close() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  weak_factory_.InvalidateWeakPtrs();
+  receiver_.reset();
+  client_.reset();
+  if (disconnected_) {
+    std::move(disconnected_).Run();
+  }
+}
+
+}  // namespace prts
