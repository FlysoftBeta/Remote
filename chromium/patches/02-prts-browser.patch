@@ -0,0 +1,320 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prts/prts_window_registry.h"
+
+#include <utility>
+
+#include "base/auto_reset.h"
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/browser_thread.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_observer.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/aura/window_tree_host_observer.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace prts {
+
+class PrtsWindowRegistry::Entry : public aura::WindowObserver,
+                                  public aura::WindowTreeHostObserver,
+                                  public views::WidgetObserver,
+                                  public TabStripModelObserver {
+ public:
+  Entry(PrtsWindowRegistry* owner,
+        uint32_t id,
+        BrowserWindowInterface* browser,
+        views::Widget* widget)
+      : owner_(owner),
+        id_(id),
+        browser_(browser),
+        widget_(widget),
+        native_(widget->GetNativeWindow()),
+        host_(native_->GetHost()),
+        tabs_(browser->GetTabStripModel()) {
+    native_->AddObserver(this);
+    if (host_->window() != native_) {
+      host_->window()->AddObserver(this);
+    }
+    host_->AddObserver(this);
+    widget_->AddObserver(this);
+    if (tabs_) {
+      tabs_->AddObserver(this);
+    }
+  }
+  ~Entry() override {
+    if (tabs_) {
+      tabs_->RemoveObserver(this);
+    }
+    widget_->RemoveObserver(this);
+    host_->RemoveObserver(this);
+    if (host_->window() != native_) {
+      host_->window()->RemoveObserver(this);
+    }
+    native_->RemoveObserver(this);
+  }
+
+  mojom::WindowInfoPtr Info() const {
+    auto info = mojom::WindowInfo::New();
+    info->window_id = id_;
+    info->size_dip = host_->window()->bounds().size();
+    info->size_px = host_->GetBoundsInPixels().size();
+    info->device_scale_factor = host_->device_scale_factor();
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    info->title =
+        view ? base::UTF16ToUTF8(view->GetWindowTitle()) : std::string();
+    return info;
+  }
+  void OnHostResized(aura::WindowTreeHost* host) override {
+    owner_->Changed(id_);  // Includes DSF-only changes on Windows.
+  }
+  void OnHostMovedInPixels(aura::WindowTreeHost* host) override {
+    owner_->Changed(id_);
+  }
+  void OnWindowBoundsChanged(aura::Window* window,
+                             const gfx::Rect& old_bounds,
+                             const gfx::Rect& new_bounds,
+                             ui::PropertyChangeReason reason) override {
+    owner_->Changed(id_);
+  }
+  void OnWindowTitleChanged(aura::Window* window) override {
+    owner_->ScheduleChanged(id_);
+  }
+  void OnWindowDestroying(aura::Window* window) override {
+    // Deletes this; do not access members afterward.
+    owner_->RemoveWindow(id_);
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    owner_->RemoveWindow(id_);
+  }
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    owner_->ScheduleChanged(id_);
+  }
+  void OnTabChangedAt(tabs::TabInterface* tab, TabChangeType type) override {
+    owner_->ScheduleChanged(id_);
+  }
+  void OnTabStripModelDestroyed(TabStripModel* model) override {
+    // TabStripModelObserver::ModelDestroyed already removed the observation.
+    tabs_ = nullptr;
+  }
+
+  const raw_ptr<PrtsWindowRegistry> owner_;
+  const uint32_t id_;
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<views::Widget> widget_;
+  const raw_ptr<aura::Window> native_;
+  const raw_ptr<aura::WindowTreeHost> host_;
+  raw_ptr<TabStripModel> tabs_;
+  mojom::WindowInfoPtr last_info_;
+};
+
+PrtsWindowRegistry::PrtsWindowRegistry() = default;
+PrtsWindowRegistry::~PrtsWindowRegistry() {
+  SetClient(nullptr);
+}
+
+void PrtsWindowRegistry::SetClient(mojom::PrtsBrowserClient* client) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  client_ = nullptr;  // The previous proxy may already have been destroyed.
+  weak_factory_.InvalidateWeakPtrs();
+  collection_observation_.Reset();
+  while (!entries_.empty()) {
+    RemoveWindow(entries_.begin()->first);
+  }
+  active_id_ = 0;
+  client_ = client;
+  if (!client_ || !ui::IsPrtsRemoteMode()) {
+    return;
+  }
+  auto* collection = GlobalBrowserCollection::GetInstance();
+  collection_observation_.Observe(collection);
+  collection->ForEach([this](BrowserWindowInterface* browser) {
+    AddWindow(browser->GetWeakPtr());
+    return true;
+  });
+  if (auto* active = collection->GetActiveBrowser()) {
+    OnBrowserActivated(active);
+  }
+}
+
+void PrtsWindowRegistry::OnBrowserCreated(BrowserWindowInterface* browser) {
+  // BrowserView may still be finishing construction in this notification.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PrtsWindowRegistry::AddWindow, weak_factory_.GetWeakPtr(),
+                     browser->GetWeakPtr()));
+}
+
+void PrtsWindowRegistry::AddWindow(
+    base::WeakPtr<BrowserWindowInterface> browser) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    return;
+  }
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser.get());
+  auto* widget = view ? view->GetWidget() : nullptr;
+  if (!widget || !widget->GetNativeWindow() ||
+      !widget->GetNativeWindow()->GetHost()) {
+    return;
+  }
+  const int32_t session = browser->GetSessionID().id();
+  auto it = session_ids_.find(session);
+  if (it == session_ids_.end()) {
+    CHECK_NE(next_id_, 0u);
+    it = session_ids_.emplace(session, next_id_++).first;
+  }
+  const uint32_t id = it->second;
+  if (entries_.contains(id)) {
+    return;
+  }
+  auto entry = std::make_unique<Entry>(this, id, browser.get(), widget);
+  entry->last_info_ = entry->Info();
+  auto info = entry->last_info_->Clone();
+  entries_.emplace(id, std::move(entry));
+  client_->WindowAdded(std::move(info));
+  if (widget->IsActive()) {
+    OnBrowserActivated(browser.get());
+  }
+}
+
+void PrtsWindowRegistry::OnBrowserClosed(BrowserWindowInterface* browser) {
+  auto it = session_ids_.find(browser->GetSessionID().id());
+  if (it != session_ids_.end()) {
+    RemoveWindow(it->second);
+  }
+}
+
+void PrtsWindowRegistry::RemoveWindow(uint32_t id) {
+  auto it = entries_.find(id);
+  if (it == entries_.end()) {
+    return;
+  }
+  for (Observer& observer : observers_) {
+    observer.OnPrtsWindowRemoving(id);
+  }
+  entries_.erase(it);
+  if (active_id_ == id) {
+    active_id_ = 0;
+  }
+  if (client_) {
+    client_->WindowRemoved(id);
+  }
+}
+
+void PrtsWindowRegistry::Changed(uint32_t id) {
+  auto it = entries_.find(id);
+  if (it == entries_.end()) {
+    return;
+  }
+  auto info = it->second->Info();
+  if (info.Equals(it->second->last_info_)) {
+    return;
+  }
+  it->second->last_info_ = info->Clone();
+  for (Observer& observer : observers_) {
+    observer.OnPrtsWindowChanged(id);
+  }
+  if (client_) {
+    client_->WindowChanged(std::move(info));
+  }
+}
+
+void PrtsWindowRegistry::ScheduleChanged(uint32_t id) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PrtsWindowRegistry::Changed,
+                                weak_factory_.GetWeakPtr(), id));
+}
+
+void PrtsWindowRegistry::OnBrowserActivated(BrowserWindowInterface* browser) {
+  auto it = session_ids_.find(browser->GetSessionID().id());
+  if (!activating_ && it != session_ids_.end()) {
+    ActivateWindow(it->second);
+  }
+}
+
+void PrtsWindowRegistry::ActivateWindow(uint32_t id) {
+  auto it = entries_.find(id);
+  if (it == entries_.end()) {
+    return;
+  }
+  base::AutoReset<bool> activating(&activating_, true);
+  for (auto& [other_id, entry] : entries_) {
+    if (other_id != id) {
+      entry->widget_->Deactivate();
+    }
+  }
+  const bool changed = active_id_ != id;
+  active_id_ = id;
+  if (focused_) {
+    it->second->widget_->Activate();
+  } else {
+    it->second->widget_->Deactivate();
+  }
+  if (changed && client_) {
+    client_->WindowActivated(id);
+  }
+}
+
+void PrtsWindowRegistry::Focus(bool focused) {
+  focused_ = focused;
+  if (focused) {
+    ActivateWindow(active_id_);
+  } else {
+    base::AutoReset<bool> activating(&activating_, true);
+    for (auto& [id, entry] : entries_) {
+      entry->widget_->Deactivate();
+    }
+  }
+}
+
+void PrtsWindowRegistry::NewWindow(const std::string& url) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Profile* profile = ProfileManager::GetLastUsedProfileAllowedByPolicy();
+  if (!profile) {
+    return;
+  }
+  if (url.empty()) {
+    chrome::NewEmptyWindow(profile, false);
+    return;
+  }
+  GURL target(url);
+  if (!target.is_valid()) {
+    return;
+  }
+  NavigateParams params(profile, target, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_WINDOW;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+aura::WindowTreeHost* PrtsWindowRegistry::GetHost(uint32_t id) const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto it = entries_.find(id);
+  return it == entries_.end() ? nullptr : it->second->host_.get();
+}
+void PrtsWindowRegistry::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+void PrtsWindowRegistry::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+}  // namespace prts
