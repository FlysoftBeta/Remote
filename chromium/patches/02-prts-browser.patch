diff --git a/chrome/browser/prts/mojom/prts.mojom b/chrome/browser/prts/mojom/prts.mojom
new file mode 100644
index 0000000000..1942c997d7
--- /dev/null
+++ b/chrome/browser/prts/mojom/prts.mojom
@@ -0,0 +1,123 @@
+// DRAFT contract (Stage 3 / M1). Final home: chrome/browser/prts/mojom/prts.mojom (patch 02),
+// shared by chrome/browser/prts (browser side) and //prts_endpoint (endpoint side).
+// Codex tasks may propose changes in their NOTES but must keep names unless a compile reason forces it.
+module prts.mojom;
+
+import "mojo/public/mojom/base/time.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+struct HelloInfo {
+  uint32 version;            // 1
+  uint64 gpu_luid;           // adapter LUID of the browser GPU process (0 = unknown/software)
+  bool software_compositing;
+};
+
+struct WindowInfo {
+  uint32 window_id;          // PRTS-assigned, stable for the life of the browser window
+  gfx.mojom.Size size_dip;   // root window size in DIP
+  float device_scale_factor;
+  gfx.mojom.Size size_px;    // host pixel size
+  string title;
+};
+
+struct CaptureParams {
+  uint32 max_fps;            // SetMinCapturePeriod(1/max_fps)
+  bool nv12;                 // false = ARGB (M1 default)
+};
+
+struct FrameInfo {
+  uint32 buffer_id;          // stable per capturer pool buffer (assigned by browser, see NewBuffer)
+  uint64 frame_seq;
+  gfx.mojom.Size coded_size;
+  gfx.mojom.Rect visible_rect;
+  gfx.mojom.Rect content_rect;
+  mojo_base.mojom.TimeTicks capture_begin;
+  mojo_base.mojom.TimeTicks capture_end;
+  mojo_base.mojom.TimeTicks reference_time;
+};
+
+// Implemented by the endpoint, one per capture. Bound on a non-UI browser sequence.
+interface PrtsFrameSink {
+  // A pool buffer seen for the first time: D3D11 shared NT handle (keyed mutex, key 0) duplicated for the endpoint.
+  NewBuffer(uint32 buffer_id, handle<platform> texture, gfx.mojom.Size coded_size);
+  // A captured frame in buffer `buffer_id`. The endpoint replies once it no longer reads the buffer
+  // (M1: after CopyResource into a private texture); the browser then calls Done() on the viz callbacks.
+  OnFrame(FrameInfo info) => ();
+  // Capturer stopped / pool rebuilt: forget all buffers.
+  Reset();
+};
+
+enum PointerType { kMouse, kTouch, kPen };
+enum PointerAction { kDown, kMove, kUp, kCancel, kLeave };
+
+struct PointerInput {
+  PointerAction action;
+  PointerType type;
+  uint8 pid;                 // 0 mouse, 1-15 touch/pen slots
+  float x;                   // normalized 0..1 of the root (viewer frame), browser multiplies by root DIP size
+  float y;
+  uint8 buttons;             // DOM buttons mask after the event
+  int8 button;               // DOM button that changed, -1 for move
+  uint8 mods;                // 1 Shift 2 Ctrl 4 Alt 8 Meta 16 Caps 32 Num 64 AltGr
+  float pressure;            // 0..1
+  float radius_x;            // DIP
+  float radius_y;
+  mojo_base.mojom.TimeTicks timestamp; // already mapped to the browser/endpoint monotonic clock (same machine)
+};
+
+struct WheelInput {
+  float x; float y;          // normalized
+  float dx; float dy;        // DIP pixels (endpoint converts lines/pages: 1 line = 40 px)
+  uint8 mods;
+  mojo_base.mojom.TimeTicks timestamp;
+};
+
+struct KeyInput {
+  bool down;
+  uint8 mods;
+  bool repeat;
+  uint16 key_code;           // DOM legacy keyCode, fallback only
+  string code;               // DOM code, e.g. "KeyA"
+  string key;                // DOM key, e.g. "a", "Enter"
+  mojo_base.mojom.TimeTicks timestamp;
+};
+
+struct ImeState {
+  uint32 seq;
+  bool focused;
+  string type;               // design/06 3.2 names
+  string mode;
+  uint32 flags;
+  gfx.mojom.RectF caret_norm; // normalized 0..1 in root
+  string reason;
+};
+
+// Implemented by the endpoint (browser -> endpoint).
+interface PrtsBrowserClient {
+  Hello(HelloInfo info);
+  WindowAdded(WindowInfo info);
+  WindowChanged(WindowInfo info);
+  WindowRemoved(uint32 window_id);
+  WindowActivated(uint32 window_id);
+  CursorChanged(string css);
+  ImeStateChanged(ImeState state);
+  VirtualKeyboard(bool show, uint32 seq);
+};
+
+// Implemented by the browser (endpoint -> browser). Bound on the browser UI thread.
+interface PrtsBrowser {
+  SetClient(pending_remote<PrtsBrowserClient> client);
+  StartCapture(uint32 window_id, CaptureParams params, pending_remote<PrtsFrameSink> sink);
+  StopCapture(uint32 window_id);
+  RequestRefreshFrame(uint32 window_id);
+  ActivateWindow(uint32 window_id);   // D8: also deactivates the other roots
+  Pointer(uint32 window_id, PointerInput input);
+  Wheel(uint32 window_id, WheelInput input);
+  Key(uint32 window_id, KeyInput input);
+  ResetInput();                        // release held keys/buttons, cancel touches
+  ImeCommit(string text);
+  ImeCompose(string text, int32 cursor);
+  ImeDelete(int32 before, int32 after);
+  Focus(bool focused);
+  NewWindow(string url);               // debug helper; empty = NTP
+};
