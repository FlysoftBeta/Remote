+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PRTS_PRTS_LINK_H_
+#define CHROME_BROWSER_PRTS_PRTS_LINK_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/prts/mojom/prts.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace prts {
+
+// Owned and used on browser UI. Chrome already initialized Mojo as a broker.
+class PrtsLink {
+ public:
+  PrtsLink(mojom::PrtsBrowser* browser, base::OnceClosure disconnected);
+  ~PrtsLink();
+  // Schedules invitation acceptance off UI, then binds the receiver on UI.
+  bool Start();
+  bool SetClient(mojo::PendingRemote<mojom::PrtsBrowserClient> client);
+  mojom::PrtsBrowserClient* client() {
+    return client_.is_bound() ? client_.get() : nullptr;
+  }
+  // Cancels acceptance, closes both bindings, runs disconnected at most once.
+  void Close();
+
+ private:
+  void Bind(mojo::ScopedMessagePipeHandle pipe);
+  mojo::Receiver<mojom::PrtsBrowser> receiver_;
+  mojo::Remote<mojom::PrtsBrowserClient> client_;
+  base::OnceClosure disconnected_;
+  bool started_ = false;
+  base::WeakPtrFactory<PrtsLink> weak_factory_{this};
+};
+
+}  // namespace prts
+
+#endif  // CHROME_BROWSER_PRTS_PRTS_LINK_H_
