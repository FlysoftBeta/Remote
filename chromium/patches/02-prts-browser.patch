+}
+
+namespace prts {
+
+class PrtsWindowRegistry;
+class PrtsCapture;
+class PrtsInput;
+class PrtsImeBridge;
+class PrtsStartupNavigationRecovery;
+
+// UI-thread dispatcher; owns only the link, never the implementation delegates.
+class PrtsController : public mojom::PrtsBrowser {
+ public:
+  PrtsController();
+  ~PrtsController() override;
+  bool Start();
+
+  void SetClient(mojo::PendingRemote<mojom::PrtsBrowserClient> client) override;
+  void StartCapture(uint32_t window_id,
+                    mojom::CaptureParamsPtr params,
+                    mojo::PendingRemote<mojom::PrtsFrameSink> sink) override;
+  void StopCapture(uint32_t window_id) override;
+  void RequestRefreshFrame(uint32_t window_id) override;
+  void ActivateWindow(uint32_t window_id) override;
+  void Pointer(uint32_t window_id, mojom::PointerInputPtr input) override;
+  void Wheel(uint32_t window_id, mojom::WheelInputPtr input) override;
+  void Key(uint32_t window_id, mojom::KeyInputPtr input) override;
+  void ResetInput() override;
+  void ImeCommit(const std::string& text) override;
+  void ImeCompose(const std::string& text, int32_t cursor) override;
+  void ImeDelete(int32_t before, int32_t after) override;
+  void Focus(bool focused) override;
+  void NewWindow(const std::string& url) override;
+
+ private:
+  void OnDisconnect();
+  void OnImeState(mojom::ImeStatePtr state);
+  void OnVirtualKeyboard(bool show, uint32_t seq);
+  void SetActiveWindow(uint32_t window_id);
+  // Declared before link_ so they outlive it.
+  std::unique_ptr<PrtsWindowRegistry> registry_;
+  std::unique_ptr<PrtsCapture> capture_;
+  std::unique_ptr<PrtsInput> input_;
+  std::unique_ptr<PrtsImeBridge> ime_;
+  raw_ptr<aura::WindowTreeHost> active_host_ = nullptr;
+  PrtsDelegates delegates_;
+  PrtsLink link_;
+  std::unique_ptr<PrtsStartupNavigationRecovery> startup_navigation_recovery_;
+};
+
+}  // namespace prts
+
+#endif  // CHROME_BROWSER_PRTS_PRTS_CONTROLLER_H_
diff --git a/chrome/browser/prts/prts_delegates.h b/chrome/browser/prts/prts_delegates.h
new file mode 100644
index 0000000000..52bf7e133d
--- /dev/null
+++ b/chrome/browser/prts/prts_delegates.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PRTS_PRTS_DELEGATES_H_
+#define CHROME_BROWSER_PRTS_PRTS_DELEGATES_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/prts/mojom/prts.mojom.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+
+namespace prts {
+
+// UI-thread interfaces, implemented by the other M1 tasks. Delegates outlive
+// PrtsController. SetClient(nullptr) must detach observers without
+// dereferencing the previous proxy. Non-null SetClient sends the initial
+// window/IME snapshot.
+class PrtsWindowRegistryDelegate {
+ public:
+  virtual ~PrtsWindowRegistryDelegate() = default;
+  virtual void SetClient(mojom::PrtsBrowserClient* client) = 0;
+  virtual void ActivateWindow(uint32_t window_id) = 0;
+  virtual void Focus(bool focused) = 0;
+  virtual void NewWindow(const std::string& url) = 0;
+};
+
+class PrtsCaptureDelegate {
+ public:
+  virtual ~PrtsCaptureDelegate() = default;
+  virtual void FillHelloInfo(mojom::HelloInfo& info) = 0;
+  // Move sink to the capture sequence before binding; read kPrtsCaptureFps
+  // here.
+  virtual void StartCapture(uint32_t window_id,
+                            mojom::CaptureParamsPtr params,
+                            mojo::PendingRemote<mojom::PrtsFrameSink> sink) = 0;
+  virtual void StopCapture(uint32_t window_id) = 0;
+  virtual void RequestRefreshFrame(uint32_t window_id) = 0;
+  // Stop all captures; release pending frame callbacks even on IPC loss.
+  virtual void StopAll() = 0;
+};
+
+class PrtsInputDelegate {
+ public:
+  virtual ~PrtsInputDelegate() = default;
+  virtual void Pointer(uint32_t window_id, mojom::PointerInputPtr input) = 0;
+  virtual void Wheel(uint32_t window_id, mojom::WheelInputPtr input) = 0;
+  virtual void Key(uint32_t window_id, mojom::KeyInputPtr input) = 0;
+  virtual void ResetInput() = 0;
+};
+
+class PrtsImeBridgeDelegate {
+ public:
+  virtual ~PrtsImeBridgeDelegate() = default;
+  virtual void SetClient(mojom::PrtsBrowserClient* client) = 0;
+  virtual void ImeCommit(const std::string& text) = 0;
+  virtual void ImeCompose(const std::string& text, int32_t cursor) = 0;
+  virtual void ImeDelete(int32_t before, int32_t after) = 0;
+  virtual void Focus(bool focused) = 0;
+};
+
+// Null delegates deliberately allow a link-only spike with no window/capture
+// implementation. Integrators inject the four concrete delegates at creation.
+struct PrtsDelegates {
+  raw_ptr<PrtsWindowRegistryDelegate> windows = nullptr;
+  raw_ptr<PrtsCaptureDelegate> capture = nullptr;
+  raw_ptr<PrtsInputDelegate> input = nullptr;
+  raw_ptr<PrtsImeBridgeDelegate> ime = nullptr;
+};
+
+}  // namespace prts
+
+#endif  // CHROME_BROWSER_PRTS_PRTS_DELEGATES_H_
diff --git a/chrome/browser/prts/prts_ime_bridge.cc b/chrome/browser/prts/prts_ime_bridge.cc
