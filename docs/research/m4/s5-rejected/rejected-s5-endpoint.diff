+// Endpoint-owned absolute clock. Lost ticks are skipped; ACKs never drive a
+// catch-up burst. Input may rephase the clock after a minimum 4 ms separation.
+class BrowserSession::RootPacer {
+ public:
+  RootPacer(mojom::PrtsBrowser* browser,
+            uint32_t id,
+            uint64_t generation,
+            bool demand,
+            base::RepeatingCallback<bool()> credit,
+            base::RepeatingClosure failure)
+      : browser_(browser),
+        id_(id),
+        generation_(generation),
+        demand_(demand),
+        credit_(std::move(credit)),
+        failure_(std::move(failure)) {
+    browser_->PaceConfig(
+        id_, generation_, interval_,
+        base::BindOnce(&RootPacer::Configured, weak_factory_.GetWeakPtr()));
+  }
+  void Input() {
+    if (!demand_ || !enabled_) {
+      return;
+    }
+    input_pending_ = true;
+    MaybeDemand();
+  }
+
+ private:
+  void Configured(bool enabled) {
+    if (!enabled) {
+      failure_.Run();
+      return;
+    }
+    enabled_ = true;
+    next_ = base::TimeTicks::Now();
+    Timer();
+  }
+  void Schedule() {
+    timer_.Start(FROM_HERE, next_, this, &RootPacer::Timer,
+                 base::subtle::DelayPolicy::kPrecise);
+  }
+  void Timer() {
+    const auto now = base::TimeTicks::Now();
+    if (now >= next_) {
+      next_ += interval_ * ((now - next_).IntDiv(interval_) + 1);
+      if (!pending_ && !recovering_ && credit_.Run()) {
+        Tick(now, false);
+      }
+    }
+    if (pending_ && !recovering_ && now - last_ > base::Seconds(2)) {
+      if (++recoveries_ > 2) {
+        LOG(ERROR) << "PRTS external BeginFrame recovery exhausted root=" << id_;
+        failure_.Run();
+        return;
+      }
+      recovering_ = true;
+      LOG(WARNING) << "PRTS external BeginFrame recovery root=" << id_;
+      browser_->PaceReset(id_, generation_,
+          base::BindOnce(&RootPacer::Recovered, weak_factory_.GetWeakPtr()));
+    }
+    Schedule();
+  }
+  void MaybeDemand() {
+    const auto now = base::TimeTicks::Now();
+    if (!input_pending_ || pending_ || recovering_ || !credit_.Run()) {
+      return;
+    }
+    const auto earliest = last_ + base::Milliseconds(4);
+    if (now < earliest) {
+      // Input in the 4 ms guard window must not wait a whole fixed period.
+      demand_timer_.Start(FROM_HERE, earliest, this, &RootPacer::MaybeDemand,
+                          base::subtle::DelayPolicy::kPrecise);
+      return;
+    }
+    demand_timer_.Stop();
+    next_ = now + interval_;
+    Tick(now, true);
+    Schedule();
+  }
+  void Tick(base::TimeTicks now, bool input) {
+    pending_ = true;
+    input_pending_ = false;
+    last_ = now;
+    if (TraceEnabled()) {
+      LOG(INFO) << "PRTS TR P root=" << id_ << " gen=" << generation_
+                << " seq=" << ++sequence_ << " t=" << TraceUs(now)
+                << " input=" << input;
+    } else {
+      ++sequence_;
+    }
+    browser_->PaceTick(
+        id_, generation_, sequence_, now,
+        base::BindOnce(&RootPacer::Ack, weak_factory_.GetWeakPtr(), sequence_));
+  }
+  void Recovered(bool recreated) {
+    if (!recreated) {
+      failure_.Run();
+      return;
+    }
+    pending_ = false;
+    recovering_ = false;
+    next_ = base::TimeTicks::Now() + interval_;
+    Schedule();
+  }
+  void Ack(uint64_t sequence, bool admitted, bool has_damage) {
+    pending_ = false;
+    if (admitted && has_damage) {
+      recoveries_ = 0;
+    }
+    if (TraceEnabled()) {
+      LOG(INFO) << "PRTS TR A root=" << id_ << " gen=" << generation_
+                << " seq=" << sequence
+                << " t=" << TraceUs(base::TimeTicks::Now())
+                << " admitted=" << admitted << " damage=" << has_damage;
+    }
+    MaybeDemand();
+  }
+  const raw_ptr<mojom::PrtsBrowser> browser_;
+  const uint32_t id_;
+  const uint64_t generation_;
+  const bool demand_;
+  const base::TimeDelta interval_ = base::Seconds(1) / 60;
+  base::RepeatingCallback<bool()> credit_;
+  base::RepeatingClosure failure_;
+  bool enabled_ = false;
+  bool pending_ = false;
+  bool recovering_ = false;
+  int recoveries_ = 0;
+  bool input_pending_ = false;
+  uint64_t sequence_ = 0;
+  base::TimeTicks next_, last_;
+  base::DeadlineTimer timer_, demand_timer_;
+  base::WeakPtrFactory<RootPacer> weak_factory_{this};
+};
