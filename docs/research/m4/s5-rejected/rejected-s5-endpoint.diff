 bool BrowserSession::Launch(base::CommandLine command) {
+  const auto& endpoint = *base::CommandLine::ForCurrentProcess();
+  // Validated S5 policy is the default for the 60 fps pipeline. Other capture
+  // rates retain the ordinary browser clock unless explicitly requested.
+  std::string mode = endpoint.HasSwitch("begin-frame-mode")
+                         ? endpoint.GetSwitchValueASCII("begin-frame-mode")
+                         : (fps_ == 60 ? "demand" : "off");
+  if (command.HasSwitch("prts-external-begin-frame") &&
+      !endpoint.HasSwitch("begin-frame-mode")) {
+    mode = "fixed";
+  }
+  if (!mode.empty() && mode != "off" && mode != "fixed" && mode != "demand") {
+    LOG(ERROR) << "--begin-frame-mode must be off, fixed or demand";
+    return false;
+  }
+  external_frames_ = mode == "fixed" || mode == "demand" ||
+                     command.HasSwitch("prts-external-begin-frame");
+  demand_frames_ = mode == "demand";
+  if (external_frames_) {
+    if (fps_ != 60) {
+      LOG(ERROR) << "External BeginFrames require --fps=60";
+      return false;
+    }
+    command.AppendSwitch("prts-external-begin-frame");
+    // Full-pipeline scheduling waits for this tick's renderer work. Removing
+    // the renderer submit-ACK gate is also needed for slow/OOPIF recovery.
+    // The stock scheduler option is only for diagnostic comparisons.
+    if (!endpoint.HasSwitch("begin-frame-stock-scheduler")) {
+      command.AppendSwitch("run-all-compositor-stages-before-draw");
+      if (command.GetSwitchValueASCII("disable-features")
+              .find("NoCompositorFrameAcks") != std::string::npos) {
+        LOG(ERROR) << "External BeginFrames require NoCompositorFrameAcks";
+        return false;
+      }
+      auto features = command.GetSwitchValueASCII("enable-features");
+      if (features.find("NoCompositorFrameAcks") == std::string::npos) {
+        if (!features.empty()) {
+          features += ",";
+        }
+        features += "NoCompositorFrameAcks";
+        command.AppendSwitchASCII("enable-features", features);
+      }
+    }
+  }
+  LOG(INFO) << "PRTS BeginFrame mode="
+            << (external_frames_ ? (demand_frames_ ? "demand" : "fixed")
+                                 : "off")
+            << " scheduler="
+            << (command.HasSwitch("run-all-compositor-stages-before-draw")
+                    ? "full"
+                    : "stock")
+            << " no_compositor_acks="
+            << (command.GetSwitchValueASCII("enable-features")
+                    .find("NoCompositorFrameAcks") != std::string::npos)
+            << " interval_us=" << (external_frames_ ? 16666 : 0)
+            << " demand_min_us=" << (demand_frames_ ? 4000 : 0)
+            << " max_in_flight=1";
