{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "strict": true, "noImplicitAny": false, "strictNullChecks": false,
    "useUnknownInCatchVariables": false, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
