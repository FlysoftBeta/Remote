# out\dev: daily development build (archive/design/05-plan.md 3.3). Copied by 'cr gen dev'.
# NaCl is gone at M157 (no enable_nacl arg). Branding uses patch 12 plus cr brand; patch 13 keeps web identity.
is_debug = false
is_component_build = true
dcheck_always_on = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
is_chrome_branded = false
use_siso = true
# Codecs (archive/design/REVIEW.md): H.264 playback in pages + OpenH264 fallback in the in-tree endpoint.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
rtc_use_h264 = true
# Widevine CDM bundled (design/07-widevine.md); the CDM files are copied into third_party/widevine/cdm/win/x64 outside the patch series.
enable_widevine = true
enable_library_cdms = true
bundle_widevine_cdm = true
enable_cdm_host_verification = false
