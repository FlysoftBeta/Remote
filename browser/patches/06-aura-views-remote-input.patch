 #include <dwmapi.h>
 
+// RB: process-lifetime weak capture owner, active only in remote mode.
+#include "base/no_destructor.h"
 #include "base/notreached.h"
 #include "base/trace_event/trace_event.h"
 #include "ui/base/mojom/window_show_state.mojom.h"
+// RB: logical capture is opt-in.
+#include "ui/base/ui_base_switches.h"
 #include "ui/base/win/hwnd_metrics.h"
 #include "ui/display/win/screen_win.h"
 #include "ui/display/win/screen_win_headless.h"
@@ -433,11 +437,29 @@ void HWNDMessageHandlerHeadless::ClearNativeFocus() {
   delegate_->HandleNativeFocus(/*last_focused_window=*/0);
 }
 
-// Headless window don't capture mouse.
-void HWNDMessageHandlerHeadless::SetCapture() {}
-void HWNDMessageHandlerHeadless::ReleaseCapture() {}
+void HWNDMessageHandlerHeadless::SetCapture() {
+  // RB: emulate native capture transfer, including capture-loss notification.
+  if (ui::IsRbRemoteMode()) {
+    static base::NoDestructor<base::WeakPtr<HWNDMessageHandler>> owner;
+    auto weak_this = GetWeakPtr();
+    if (*owner && owner->get() != this)
+      (*owner)->ReleaseCapture();
+    if (!weak_this)
+      return;
+    *owner = weak_this;
+    remote_has_capture_ = true;
+  }
+}
+void HWNDMessageHandlerHeadless::ReleaseCapture() {
+  // RB: mirror WM_CAPTURECHANGED; clear before the reentrant notification.
+  if (ui::IsRbRemoteMode() && remote_has_capture_) {
+    remote_has_capture_ = false;
+    delegate_->HandleCaptureLost();
+  }
+}
 bool HWNDMessageHandlerHeadless::HasCapture() const {
-  return false;
+  // RB: Views requires both Aura capture and native-handler capture.
+  return ui::IsRbRemoteMode() && remote_has_capture_;
 }
 
 FullscreenHandler* HWNDMessageHandlerHeadless::fullscreen_handler() {
