diff --git a/ui/views/widget/desktop_aura/remote_cursor_sink.h b/ui/views/widget/desktop_aura/remote_cursor_sink.h
new file mode 100644
index 0000000000..1389c6a86e
--- /dev/null
+++ b/ui/views/widget/desktop_aura/remote_cursor_sink.h
@@ -0,0 +1,28 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef UI_VIEWS_WIDGET_DESKTOP_AURA_REMOTE_CURSOR_SINK_H_
+#define UI_VIEWS_WIDGET_DESKTOP_AURA_REMOTE_CURSOR_SINK_H_
+
+#include "ui/base/cursor/cursor.h"
+#include "ui/views/views_export.h"
+
+namespace aura {
+class Window;
+}
+namespace views {
+// UI sequence only. Register before remote hosts are shown; clear before
+// teardown. The embedder maps cursor types to CSS, filtering roots by the
+// active window. The full logical cursor preserves custom pixels and hotspot.
+class VIEWS_EXPORT RemoteCursorSink {
+ public:
+  static void SetInstance(RemoteCursorSink* sink);
+  static RemoteCursorSink* GetInstance();
+  virtual void OnCursorChanged(aura::Window* root,
+                               const ui::Cursor& cursor) = 0;
+
+ protected:
+  virtual ~RemoteCursorSink() = default;
+};
+}  // namespace views
+#endif  // UI_VIEWS_WIDGET_DESKTOP_AURA_REMOTE_CURSOR_SINK_H_
