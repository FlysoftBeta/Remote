@@ -1070,6 +1073,60 @@ void SkiaOutputSurfaceImplOnGpu::CopyOutputRGBAInTexture(
   // receive a callback that the GPU work has completed - otherwise,
   // memory-mapping the GMB may not yield the latest version of the
   // contents.
+#if BUILDFLAG(IS_WIN)
+  // RB: only a negotiated no-keyed pool may bypass CPU completion.
+  if (request->has_blit_request() &&
+      request->blit_request().shared_image()->debug_label() ==
+          "RbFenceCapturePool" &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("rb-remote")) {
+    auto writer = context_state_->GetD3D11Device();
+    if (!writer || !graphite_shared_context()) {
+      return;
+    }
+    if (!rb_ready_fence_ || rb_ready_fence_->GetD3D11Device() != writer) {
+      rb_ready_fence_ = gfx::D3DSharedFence::CreateForD3D11(writer);
+      rb_fence_token_ = base::UnguessableToken::Create();
+    }
+    if (!rb_ready_fence_ ||
+        !FlushAndSubmitCopyOutput("RbFenceRGBA", scoped_write->surface(),
+                                  end_semaphores, representation.get(),
+                                  scoped_write.get())) {
+      return;
+    }
+    // Dawn's deferred D3D11 flush must precede Signal on its immediate context.
+    graphite_shared_context()->submitAndFlushBackend();
+    scoped_write.reset();
+    // Include any EndAccess-generated Dawn work before the export signal.
+    graphite_shared_context()->submitAndFlushBackend();
+    if (!rb_ready_fence_->IncrementAndSignalD3D11()) {
+      return;
+    }
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext> context;
+    writer->GetImmediateContext(&context);
+    context->Flush();
+    auto ready = std::make_shared<RbD3D11ReadyFence>();
+    ready->handle = rb_ready_fence_->CloneSharedHandle();
+    ready->token = rb_fence_token_;
+    ready->value = rb_ready_fence_->GetFenceValue();
+    Microsoft::WRL::ComPtr<IDXGIDevice> dxgi;
+    Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+    DXGI_ADAPTER_DESC desc{};
+    if (!ready->handle.is_valid() || FAILED(writer.As(&dxgi)) ||
+        FAILED(dxgi->GetAdapter(&adapter)) || FAILED(adapter->GetDesc(&desc))) {
+      return;
+    }
+    ready->adapter_luid =
+        (uint64_t{static_cast<uint32_t>(desc.AdapterLuid.HighPart)} << 32) |
+        desc.AdapterLuid.LowPart;
+    auto result = std::make_unique<RbCopyOutputSharedImageResult>(
+        CopyOutputResult::Format::RGBA, geometry.result_selection,
+        request->blit_request().shared_image(),
+        std::move(blit_release_callback));
+    result->ready_fence = std::move(ready);
+    request->SendResult(std::move(result));
+    return;
+  }
+#endif
   const bool should_wait_for_gpu_work =
       request->has_blit_request() &&
       request->blit_request().populates_mappable_shared_image();
