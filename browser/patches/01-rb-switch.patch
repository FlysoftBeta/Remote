From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flysoft <flysoftbeta@outlook.com>
Date: Mon, 26 Oct 2026 13:44:09 +0800
Subject: [PATCH] rb: --rb-remote switch and ui::IsRbRemoteMode()

Patch-Name: 01-rb-switch

diff --git a/ui/base/BUILD.gn b/ui/base/BUILD.gn
index dd9811827c..13d9021690 100644
--- a/ui/base/BUILD.gn
+++ b/ui/base/BUILD.gn
@@ -215,6 +215,8 @@ component("base") {
     "ui_base_exports.cc",
     "ui_base_paths.cc",
     "ui_base_paths.h",
+    # RB: Shared runtime switch implementation.
+    "ui_base_switches.cc",
     "ui_base_switches.h",
     "ui_base_switches_util.cc",
     "ui_base_switches_util.h",
diff --git a/ui/base/ui_base_switches.cc b/ui/base/ui_base_switches.cc
new file mode 100644
index 0000000000..9e13c54117
--- /dev/null
+++ b/ui/base/ui_base_switches.cc
@@ -0,0 +1,18 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/base/ui_base_switches.h"
+
+#include "base/command_line.h"
+
+namespace ui {
+
+// RB: Share one process-wide runtime guard across UI and browser hooks.
+bool IsRbRemoteMode() {
+  static const bool enabled =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kRbRemote);
+  return enabled;
+}
+
+}  // namespace ui
diff --git a/ui/base/ui_base_switches.h b/ui/base/ui_base_switches.h
index 78095269c8..952d4b3c8c 100644
--- a/ui/base/ui_base_switches.h
+++ b/ui/base/ui_base_switches.h
@@ -12,6 +12,9 @@
 
 namespace switches {
 
+// RB: Enables remote browser UI behavior for this process.
+inline constexpr char kRbRemote[] = "rb-remote";
+
 #if BUILDFLAG(IS_ANDROID)
 // Disable overscroll edge effects like those found in Android views.
 inline constexpr char kDisableOverscrollEdgeEffect[] =
@@ -119,4 +122,11 @@ inline constexpr char kMangleLocalizedStrings[] = "mangle-localized-strings";
 
 }  // namespace switches
 
+namespace ui {
+
+// RB: Cached on first use after CommandLine initialization. Immutable at runtime.
+COMPONENT_EXPORT(UI_BASE) bool IsRbRemoteMode();
+
+}  // namespace ui
+
 #endif  // UI_BASE_UI_BASE_SWITCHES_H_
