--- /dev/null
+++ b/chrome/browser/rb/rb_link.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rb/rb_link.h"
+
+#include <windows.h>
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/rb/rb_switches.h"
+#include "content/public/browser/browser_thread.h"
+#include "mojo/public/cpp/platform/platform_channel.h"
+#include "mojo/public/cpp/system/invitation.h"
+#include "ui/base/ui_base_switches.h"
+
+namespace rb {
+
+RbLink::RbLink(mojom::RbBrowser* browser, base::OnceClosure disconnected)
+    : receiver_(browser), disconnected_(std::move(disconnected)) {}
+RbLink::~RbLink() = default;
+
+bool RbLink::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (started_ || !ui::IsRbRemoteMode() ||
+      !command_line->HasSwitch(switches::kRbMojo)) {
+    return false;
+  }
+  auto endpoint = mojo::PlatformChannel::RecoverPassedEndpointFromString(
+      command_line->GetSwitchValueASCII(switches::kRbMojo));
+  command_line->RemoveSwitch(switches::kRbMojo);
+  if (!endpoint.is_valid() ||
+      !::SetHandleInformation(endpoint.platform_handle().GetHandle().get(),
+                              HANDLE_FLAG_INHERIT, 0)) {
+    LOG(ERROR) << "PRTS: invalid inherited Mojo endpoint";
+    return false;
+  }
+  started_ = true;
+  return base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&mojo::IncomingInvitation::AcceptIsolated,
+                     std::move(endpoint)),
+      base::BindOnce(&RbLink::Bind, weak_factory_.GetWeakPtr()));
+}
+
+void RbLink::Bind(mojo::ScopedMessagePipeHandle pipe) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!pipe.is_valid()) {
+    Close();
+    return;
+  }
+  receiver_.Bind(mojo::PendingReceiver<mojom::RbBrowser>(std::move(pipe)));
+  receiver_.set_disconnect_handler(
+      base::BindOnce(&RbLink::Close, weak_factory_.GetWeakPtr()));
+}
+
+bool RbLink::SetClient(mojo::PendingRemote<mojom::RbBrowserClient> client) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!client.is_valid() || client_.is_bound()) {
+    return false;
+  }
+  client_.Bind(std::move(client));
+  client_.set_disconnect_handler(
+      base::BindOnce(&RbLink::Close, weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void RbLink::Close() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  weak_factory_.InvalidateWeakPtrs();
+  receiver_.reset();
+  client_.reset();
+  if (disconnected_) {
+    std::move(disconnected_).Run();
+  }
+}
+
+}  // namespace rb
diff --git a/chrome/browser/rb/rb_link.h b/chrome/browser/rb/rb_link.h
new file mode 100644
index 0000000000..245a0d6378
--- /dev/null
+++ b/chrome/browser/rb/rb_link.h
@@ -0,0 +1,41 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RB_RB_LINK_H_
+#define CHROME_BROWSER_RB_RB_LINK_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/rb/mojom/rb.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace rb {
+
+// Owned and used on browser UI. Chrome already initialized Mojo as a broker.
+class RbLink {
+ public:
+  RbLink(mojom::RbBrowser* browser, base::OnceClosure disconnected);
+  ~RbLink();
+  // Schedules invitation acceptance off UI, then binds the receiver on UI.
+  bool Start();
+  bool SetClient(mojo::PendingRemote<mojom::RbBrowserClient> client);
+  mojom::RbBrowserClient* client() {
+    return client_.is_bound() ? client_.get() : nullptr;
+  }
+  // Cancels acceptance, closes both bindings, runs disconnected at most once.
+  void Close();
+
+ private:
+  void Bind(mojo::ScopedMessagePipeHandle pipe);
+  mojo::Receiver<mojom::RbBrowser> receiver_;
+  mojo::Remote<mojom::RbBrowserClient> client_;
+  base::OnceClosure disconnected_;
+  bool started_ = false;
+  base::WeakPtrFactory<RbLink> weak_factory_{this};
+};
+
+}  // namespace rb
+
+#endif  // CHROME_BROWSER_RB_RB_LINK_H_
