+#ifndef CHROME_BROWSER_RB_RB_CURSOR_BRIDGE_H_
+#define CHROME_BROWSER_RB_RB_CURSOR_BRIDGE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/cursor/cursor.h"
+#include "ui/views/widget/desktop_aura/remote_cursor_sink.h"
+
+namespace aura {
+class WindowTreeHost;
+}
+
+namespace rb {
+
+// UI sequence only. Owns the Views sink registration for the controller's life.
+class RbCursorBridge : public views::RemoteCursorSink {
+ public:
+  explicit RbCursorBridge(
+      base::RepeatingCallback<void(const std::string&)> send);
+  ~RbCursorBridge() override;
+  void SetActiveHost(aura::WindowTreeHost* host);
+  void OnCursorChanged(aura::Window* root, const ui::Cursor& cursor) override;
+
+ private:
+  base::RepeatingCallback<void(const std::string&)> send_;
+  base::WeakPtr<aura::WindowTreeHost> host_;
