+#ifndef CHROME_BROWSER_RB_RB_WINDOW_REGISTRY_H_
+#define CHROME_BROWSER_RB_RB_WINDOW_REGISTRY_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/rb/rb_delegates.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+
+namespace aura {
+class WindowTreeHost;
+}
+
+namespace rb {
+
+// UI thread only. At this pin GlobalBrowserCollection replaces BrowserList.
+class RbWindowRegistry final : public RbWindowRegistryDelegate,
+                                 public BrowserCollectionObserver {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnRbWindowChanged(uint32_t id) = 0;
+    // Called before detaching the host, including when the client disconnects.
+    virtual void OnRbWindowRemoving(uint32_t id) = 0;
+  };
+
+  RbWindowRegistry();
+  ~RbWindowRegistry() override;
+  void SetClient(mojom::RbBrowserClient* client) override;
+  void ActivateWindow(uint32_t id) override;
+  void Focus(bool focused) override;
+  void NewWindow(const std::string& url) override;
+
+  aura::WindowTreeHost* GetHost(uint32_t id) const;
+  void MaximizeAll();
+  uint32_t active_window_id() const { return active_id_; }
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  class Entry;
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+  void AddWindow(base::WeakPtr<BrowserWindowInterface> browser);
+  void RemoveWindow(uint32_t id);
+  void Changed(uint32_t id);
+  void ScheduleChanged(uint32_t id);
+
+  raw_ptr<mojom::RbBrowserClient> client_ = nullptr;
+  std::map<uint32_t, std::unique_ptr<Entry>> entries_;
+  // Integer tombstones preserve assigned IDs over disconnect/reconnect without
+  // retaining pointers to browsers whose lifetimes are no longer observed.
+  std::map<int32_t, uint32_t> session_ids_;
+  uint32_t next_id_ = 1;
+  uint32_t active_id_ = 0;
+  bool focused_ = true;
+  bool activating_ = false;
+  base::ObserverList<Observer> observers_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      collection_observation_{this};
+  base::WeakPtrFactory<RbWindowRegistry> weak_factory_{this};
+};
+
+}  // namespace rb
+
+#endif  // CHROME_BROWSER_RB_RB_WINDOW_REGISTRY_H_
