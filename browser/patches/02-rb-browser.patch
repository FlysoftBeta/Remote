+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RB_RB_CONTROLLER_H_
+#define CHROME_BROWSER_RB_RB_CONTROLLER_H_
+
+#include "chrome/browser/rb/rb_delegates.h"
+#include "chrome/browser/rb/rb_link.h"
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+
+namespace aura {
+class WindowTreeHost;
+}
+
+namespace rb {
+
+class RbWindowRegistry;
+class RbCapture;
+class RbInput;
+class RbImeBridge;
+class RbCursorBridge;
+class RbStartupNavigationRecovery;
+
+// UI-thread dispatcher; owns only the link, never the implementation delegates.
+class RbController : public mojom::RbBrowser {
+ public:
+  RbController();
+  ~RbController() override;
+  bool Start();
+
+  void SetClient(mojo::PendingRemote<mojom::RbBrowserClient> client) override;
+  void StartCapture(uint32_t window_id,
+                    mojom::CaptureParamsPtr params,
+                    mojo::PendingRemote<mojom::RbFrameSink> sink) override;
+  void StopCapture(uint32_t window_id) override;
+  void RequestRefreshFrame(uint32_t window_id) override;
+  void ActivateWindow(uint32_t window_id) override;
+  void Pointer(uint32_t window_id, mojom::PointerInputPtr input) override;
+  void Wheel(uint32_t window_id, mojom::WheelInputPtr input) override;
+  void Key(uint32_t window_id, mojom::KeyInputPtr input) override;
+  void ResetInput() override;
+  void ImeCommit(const std::string& text, uint32_t context) override;
+  void ImeCompose(const std::string& text,
+                  int32_t cursor,
+                  uint32_t context) override;
+  void ImeDelete(int32_t before, int32_t after, uint32_t context) override;
+  void ImeHidden(uint32_t context) override;
+  void Focus(bool focused) override;
+  void SetTouchCapabilities(uint8_t touch_points, bool touch_only) override;
+  void NewWindow(const std::string& url) override;
+  void SetViewport(const gfx::Size& dip, float dsf) override;
+
+ private:
+  void OnDisconnect();
+  void OnCursor(const std::string& css);
+  void OnImeState(mojom::ImeStatePtr state);
+  void OnVirtualKeyboard(bool show, uint32_t seq);
+  void SetActiveWindow(uint32_t window_id);
+  // Declared before link_ so they outlive it.
+  std::unique_ptr<RbWindowRegistry> registry_;
+  std::unique_ptr<RbCapture> capture_;
+  std::unique_ptr<RbInput> input_;
+  std::unique_ptr<RbImeBridge> ime_;
+  std::unique_ptr<RbCursorBridge> cursor_;
+  raw_ptr<aura::WindowTreeHost> active_host_ = nullptr;
+  RbDelegates delegates_;
+  RbLink link_;
+  std::unique_ptr<RbStartupNavigationRecovery> startup_navigation_recovery_;
+};
+
+}  // namespace rb
+
+#endif  // CHROME_BROWSER_RB_RB_CONTROLLER_H_
