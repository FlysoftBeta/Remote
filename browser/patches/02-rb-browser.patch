index 0000000000..ec82ca9f67
--- /dev/null
+++ b/chrome/browser/rb/rb_controller.cc
@@ -0,0 +1,347 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rb/rb_controller.h"
+
+#include <cmath>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/rb/rb_capture.h"
+#include "chrome/browser/rb/rb_cursor_bridge.h"
+#include "chrome/browser/rb/rb_content_browser_client_part.h"
+#include "chrome/browser/rb/rb_ime_bridge.h"
+#include "chrome/browser/rb/rb_input.h"
+#include "chrome/browser/rb/rb_window_registry.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/network_service_instance.h"
+#include "content/public/browser/service_process_info.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "net/base/net_errors.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/display/win/screen_win_headless.h"
+#include "url/gurl.h"
+
+namespace rb {
+
+// A Network Service bootstrap crash can silently abort the startup GET, leaving
+// an initial empty document (and therefore no animation or compositor damage).
+// Retry that one navigation after the replacement service has connected. Keep
+// the usual process/sandbox configuration and never replay a committed load.
+class RbStartupNavigationRecovery final
+    : public content::WebContentsObserver,
+      public content::NetworkServiceProcessObserver,
+      public BrowserCollectionObserver {
+ public:
+  RbStartupNavigationRecovery() {
+    browser_observation_.Observe(GlobalBrowserCollection::GetInstance());
+    AttachStartupContents();
+    content::AddNetworkServiceProcessObserver(this);
+  }
+  ~RbStartupNavigationRecovery() override { Retire(); }
+
+ private:
+  void Retire() {
+    Observe(nullptr);
+    browser_observation_.Reset();
+    if (observing_network_) {
+      content::RemoveNetworkServiceProcessObserver(this);
+      observing_network_ = false;
+    }
+    weak_factory_.InvalidateWeakPtrs();
+  }
+  void WebContentsDestroyed() override {
+    retried_ = true;
+    Retire();
+  }
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RbStartupNavigationRecovery::AttachStartupContents,
+                       weak_factory_.GetWeakPtr()));
+  }
+  void AttachStartupContents() {
+    if (web_contents() || retried_) {
+      return;
+    }
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [this](BrowserWindowInterface* browser) {
+          auto* tabs = browser->GetTabStripModel();
+          auto* contents = tabs ? tabs->GetActiveWebContents() : nullptr;
+          if (!contents || !contents->GetController().IsInitialNavigation()) {
+            return true;
+          }
+          Observe(contents);
+          return false;
+        });
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      aborted_url_ = GURL();
+    }
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
+      Retire();
+      return;
+    }
+    if (handle->IsInPrimaryMainFrame() && !handle->IsRendererInitiated() &&
+        handle->IsNavigatingFromInitialEmptyDocument() &&
+        handle->GetRequestMethod() == "GET" && !handle->IsPost() &&
+        !handle->HasCommitted() && handle->GetNetErrorCode() == net::ERR_ABORTED &&
+        handle->GetURL().SchemeIsHTTPOrHTTPS()) {
+      aborted_url_ = handle->GetURL();
+      ScheduleRetry();
+    }
+  }
+  void DidStopLoading() override { ScheduleRetry(); }
+  void OnServiceCrashed(const content::ServiceProcessInfo& info) override {
+    service_ready_ = false;
+    bootstrap_crashed_ |= info.crashed_pre_ipc().value_or(false);
+    if (bootstrap_crashed_) {
+      LOG(INFO) << "PRTS: Network Service bootstrap crashed";
+    }
+  }
+  void OnServiceLaunched(const content::ServiceProcessInfo& info) override {
+    service_ready_ = true;
+    ScheduleRetry();
+  }
+  void ScheduleRetry() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RbStartupNavigationRecovery::MaybeRetry,
+                       weak_factory_.GetWeakPtr()));
+  }
+  void MaybeRetry() {
+    auto* contents = web_contents();
+    if (retried_ || !bootstrap_crashed_ || !service_ready_ ||
+        aborted_url_.is_empty() || !contents || contents->IsLoading() ||
+        !contents->GetController().IsInitialNavigation()) {
+      return;
+    }
+    // The failed initial load retains its pending entry for the omnibox. It is
+    // safe to replace that entry, but never replace a different navigation.
+    auto* pending = contents->GetController().GetPendingEntry();
+    if (pending && pending->GetURL() != aborted_url_) {
+      return;
+    }
+    retried_ = true;
+    Retire();
+    LOG(INFO) << "PRTS: retrying startup GET after Network Service bootstrap";
+    content::NavigationController::LoadURLParams params(aborted_url_);
+    contents->GetController().LoadURLWithParams(params);
+  }
+
+  GURL aborted_url_;
+  bool bootstrap_crashed_ = false;
+  bool service_ready_ = false;
+  bool retried_ = false;
+  bool observing_network_ = true;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_observation_{this};
+  base::WeakPtrFactory<RbStartupNavigationRecovery> weak_factory_{this};
+};
+
+RbController::RbController()
+    : registry_(std::make_unique<RbWindowRegistry>()),
+      capture_(std::make_unique<RbCapture>(registry_.get())),
+      input_(std::make_unique<RbInput>()),
+      ime_(std::make_unique<RbImeBridge>(
+          base::BindRepeating(&RbController::OnImeState,
+                              base::Unretained(this)),
+          base::BindRepeating(&RbController::OnVirtualKeyboard,
+                              base::Unretained(this)))),
+      cursor_(std::make_unique<RbCursorBridge>(
+          base::BindRepeating(&RbController::OnCursor,
+                              base::Unretained(this)))),
+      delegates_{registry_.get(), capture_.get(), nullptr, nullptr},
+      link_(this,
+            base::BindOnce(&RbController::OnDisconnect,
+                           base::Unretained(this))) {
+  if (ui::IsRbRemoteMode()) {
+    startup_navigation_recovery_ =
+        std::make_unique<RbStartupNavigationRecovery>();
+  }
+}
+RbController::~RbController() {
+  link_.Close();
+  ime_->SetActiveHost(nullptr);
+  cursor_->SetActiveHost(nullptr);
+}
+
+void RbController::OnCursor(const std::string& css) {
+  if (link_.client()) {
+    link_.client()->CursorChanged(css);
+  }
+}
+
+void RbController::OnImeState(mojom::ImeStatePtr state) {
+  if (link_.client()) {
+    link_.client()->ImeStateChanged(std::move(state));
+  }
+}
+
+void RbController::OnVirtualKeyboard(bool show, uint32_t seq) {
+  if (link_.client()) {
+    link_.client()->VirtualKeyboard(show, seq);
+  }
+}
+
+void RbController::SetActiveWindow(uint32_t window_id) {
+  aura::WindowTreeHost* host = registry_->GetHost(window_id);
+  if (host != active_host_) {
+    input_->ResetInput();
+    active_host_ = host;
+    ime_->SetActiveHost(host);
+    cursor_->SetActiveHost(host);
+  }
+}
+bool RbController::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return link_.Start();
+}
+
+void RbController::SetClient(
+    mojo::PendingRemote<mojom::RbBrowserClient> client) {
+  if (!link_.SetClient(std::move(client))) {
+    return;
+  }
+  auto hello = mojom::HelloInfo::New();
+  hello->version = 1;
+  hello->gpu_luid = 0;
+  hello->software_compositing = true;  // Conservative link-only spike default.
+  if (delegates_.capture) {
+    delegates_.capture->FillHelloInfo(*hello);
+  }
+  link_.client()->Hello(std::move(hello));
+  if (delegates_.windows) {
+    delegates_.windows->SetClient(link_.client());
+  }
+}
+
+void RbController::SetTouchCapabilities(uint8_t touch_points, bool touch_only) {
+  if (!RbContentBrowserClientPart::SetTouchCapabilities(touch_points,
+                                                        touch_only)) {
+    return;
+  }
+  // The initial page can exist before ctl hello; also refresh background tabs.
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [](BrowserWindowInterface* browser) {
+        auto* tabs = browser->GetTabStripModel();
+        for (int i = 0; tabs && i < tabs->count(); ++i) {
+          tabs->GetWebContentsAt(i)->OnWebPreferencesChanged();
+        }
+        return true;
+      });
+}
+
+void RbController::StartCapture(
+    uint32_t window_id,
+    mojom::CaptureParamsPtr params,
+    mojo::PendingRemote<mojom::RbFrameSink> sink) {
+  if (delegates_.capture) {
+    SetActiveWindow(window_id);
+    delegates_.capture->StartCapture(window_id, std::move(params),
+                                     std::move(sink));
+  }
+}
+void RbController::StopCapture(uint32_t window_id) {
+  if (delegates_.capture) {
+    delegates_.capture->StopCapture(window_id);
+  }
+}
+void RbController::RequestRefreshFrame(uint32_t window_id) {
+  if (delegates_.capture) {
+    delegates_.capture->RequestRefreshFrame(window_id);
+  }
+}
+void RbController::ActivateWindow(uint32_t window_id) {
+  SetActiveWindow(window_id);
+  if (delegates_.windows) {
+    delegates_.windows->ActivateWindow(window_id);
+  }
+}
+void RbController::Pointer(uint32_t window_id, mojom::PointerInputPtr input) {
+  SetActiveWindow(window_id);
+  if (aura::WindowTreeHost* host = registry_->GetHost(window_id)) {
+    input_->Pointer(host, *input);
+  }
+}
+void RbController::Wheel(uint32_t window_id, mojom::WheelInputPtr input) {
+  SetActiveWindow(window_id);
+  if (aura::WindowTreeHost* host = registry_->GetHost(window_id)) {
+    input_->Wheel(host, *input);
+  }
+}
+void RbController::Key(uint32_t window_id, mojom::KeyInputPtr input) {
+  SetActiveWindow(window_id);
+  if (aura::WindowTreeHost* host = registry_->GetHost(window_id)) {
+    input_->Key(host, *input);
+  }
+}
+void RbController::ResetInput() {
+  input_->ResetInput();
+}
+void RbController::ImeCommit(const std::string& text, uint32_t context) {
+  ime_->ImeCommit(text, context);
+}
+void RbController::ImeCompose(const std::string& text,
+                                int32_t cursor,
+                                uint32_t context) {
+  ime_->ImeCompose(text, cursor, context);
+}
+void RbController::ImeDelete(int32_t before,
+                               int32_t after,
+                               uint32_t context) {
+  ime_->ImeDelete(before, after, context);
+}
+void RbController::ImeHidden(uint32_t context) {
+  ime_->ImeHidden(context);
+}
+void RbController::Focus(bool focused) {
+  if (!focused) {
+    ResetInput();
+  }
+  if (delegates_.windows) {
+    delegates_.windows->Focus(focused);
+  }
+}
+void RbController::SetViewport(const gfx::Size& dip, float dsf) {
+  if (!ui::IsRbRemoteMode() || dip.IsEmpty() || dip.width() > 8192 ||
+      dip.height() > 8192 || !std::isfinite(dsf) || dsf < 1.0f || dsf > 4.0f) {
+    return;
+  }
+  auto* screen = display::win::GetScreenWinHeadless();
+  screen->SetPrimaryDisplayGeometry(dip, dsf);
+  registry_->MaximizeAll();
+}
+
+void RbController::NewWindow(const std::string& url) {
+  if (delegates_.windows) {
+    delegates_.windows->NewWindow(url);
+  }
+}
+void RbController::OnDisconnect() {
+  startup_navigation_recovery_.reset();
+  if (delegates_.windows) {
+    delegates_.windows->SetClient(nullptr);
+  }
+  ResetInput();
+  if (delegates_.capture) {
+    delegates_.capture->StopAll();
+  }
+}
+
+}  // namespace rb
