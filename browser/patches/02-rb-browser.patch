+void FillRbGpuHelloInfo(mojom::HelloInfo& info);
+
+// UI-thread owner. Registry must outlive this object; destroy controller first.
+class RbCapture final : public RbCaptureDelegate,
+                          public RbWindowRegistry::Observer {
+ public:
