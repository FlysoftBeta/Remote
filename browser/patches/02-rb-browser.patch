+#ifndef CHROME_BROWSER_RB_RB_INPUT_H_
+#define CHROME_BROWSER_RB_RB_INPUT_H_
+
+#include <cstdint>
+#include <map>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/rb/mojom/rb.mojom.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace aura {
+class WindowTreeHost;
+}
+namespace rb {
+// One per remote session, UI sequence only. The registry supplies the requested
+// window's host; located events are rerouted through logical capture as needed.
+// Reset before changing active windows and on viewer blur/disconnect.
+class RbInput {
+ public:
+  RbInput();
+  ~RbInput();
+  void Pointer(aura::WindowTreeHost* host, const mojom::PointerInput& input);
+  void Wheel(aura::WindowTreeHost* host, const mojom::WheelInput& input);
+  void Key(aura::WindowTreeHost* host, const mojom::KeyInput& input);
+  void ResetInput();
+
+ private:
+  struct HeldKey {
+    base::WeakPtr<aura::WindowTreeHost> host;
+    ui::KeyEvent event;
+  };
+  struct HeldTouch {
+    base::WeakPtr<aura::WindowTreeHost> host;
+    gfx::PointF location;
+    ui::PointerDetails details;
+  };
+  void InjectMouse(aura::WindowTreeHost* host, ui::MouseEvent* event);
+  void Touch(aura::WindowTreeHost* host, const mojom::PointerInput& input);
+  int buttons_ = 0;
+  int mods_ = 0;
+  bool mouse_inside_ = false;
+  base::WeakPtr<aura::WindowTreeHost> mouse_host_;
+  gfx::PointF mouse_location_;
+  base::TimeTicks last_click_time_;
+  gfx::PointF last_click_location_;
+  int last_click_button_ = 0;
+  int click_count_ = 0;
+  std::map<std::string, HeldKey> keys_;
+  std::map<uint8_t, HeldTouch> touches_;
+  base::WeakPtrFactory<RbInput> weak_factory_{this};
+};
+}  // namespace rb
+#endif  // CHROME_BROWSER_RB_RB_INPUT_H_
