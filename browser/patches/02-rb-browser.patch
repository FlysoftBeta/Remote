+namespace ui {
+class RemoteInputMethod;
+class TextInputClient;
+}  // namespace ui
+namespace rb {
+// UI sequence only. One observer of the active root, shared by Views and
+// content. Call SetActiveHost(nullptr) before registry teardown. Callback sinks
+// normally forward to RbBrowserClient; seq is session-wide, not reset on host
+// switches.
+class RbImeBridge : public ui::InputMethodObserver {
+ public:
+  using StateCallback = base::RepeatingCallback<void(mojom::ImeStatePtr)>;
+  using KeyboardCallback = base::RepeatingCallback<void(bool, uint32_t)>;
+  RbImeBridge(StateCallback state, KeyboardCallback keyboard);
+  ~RbImeBridge() override;
+  void SetActiveHost(aura::WindowTreeHost* host);
+  void ImeCommit(const std::string& text, uint32_t context);
+  void ImeCompose(const std::string& text, int32_t cursor, uint32_t context);
+  void ImeDelete(int32_t before, int32_t after, uint32_t context);
+  void ImeHidden(uint32_t context);
+
+  void OnFocus() override;
+  void OnBlur() override;
+  void OnCaretBoundsChanged(const ui::TextInputClient* client) override;
+  void OnTextInputStateChanged(const ui::TextInputClient* client) override;
+  void OnInputMethodDestroyed(const ui::InputMethod* input_method) override;
+
+ private:
+  ui::TextInputClient* EditableClient() const;
+  void Publish();
+  void OnKeyboard(bool show);
+  void OnCompositionCancelled();
+  StateCallback state_callback_;
+  KeyboardCallback keyboard_callback_;
+  base::WeakPtr<aura::WindowTreeHost> host_;
+  base::WeakPtr<ui::TextInputClient> client_;
+  raw_ptr<ui::RemoteInputMethod> input_method_ = nullptr;
+  bool focused_ = false;
+  uint32_t seq_ = 0;
+  uint32_t context_ = 1;
+  base::WeakPtrFactory<RbImeBridge> weak_factory_{this};
+};
+}  // namespace rb
+#endif  // CHROME_BROWSER_RB_RB_IME_BRIDGE_H_
diff --git a/chrome/browser/rb/rb_input.cc b/chrome/browser/rb/rb_input.cc
new file mode 100644
index 0000000000..19c19744c0
--- /dev/null
+++ b/chrome/browser/rb/rb_input.cc
@@ -0,0 +1,353 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rb/rb_input.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "ui/aura/event_injector.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/display/win/screen_win_headless.h"
+#include "ui/events/event_dispatcher.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/events/keycodes/keyboard_code_conversion.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/views/widget/desktop_aura/desktop_capture_client.h"
+#include "ui/wm/core/coordinate_conversion.h"
+
+namespace rb {
+namespace {
+int Modifiers(uint8_t mods) {
+  return ((mods & 1) ? ui::EF_SHIFT_DOWN : 0) |
+         ((mods & 2) ? ui::EF_CONTROL_DOWN : 0) |
+         ((mods & 4) ? ui::EF_ALT_DOWN : 0) |
+         ((mods & 8) ? ui::EF_COMMAND_DOWN : 0) |
+         ((mods & 16) ? ui::EF_CAPS_LOCK_ON : 0) |
+         ((mods & 32) ? ui::EF_NUM_LOCK_ON : 0) |
+         ((mods & 64) ? ui::EF_ALTGR_DOWN : 0);
+}
+int Button(int button) {
+  switch (button) {
+    case 0:
+      return ui::EF_LEFT_MOUSE_BUTTON;
+    case 1:
+      return ui::EF_MIDDLE_MOUSE_BUTTON;
+    case 2:
+      return ui::EF_RIGHT_MOUSE_BUTTON;
+    case 3:
+      return ui::EF_BACK_MOUSE_BUTTON;
+    case 4:
+      return ui::EF_FORWARD_MOUSE_BUTTON;
+    default:
+      return 0;
+  }
+}
+int Buttons(uint8_t buttons) {
+  return ((buttons & 1) ? ui::EF_LEFT_MOUSE_BUTTON : 0) |
+         ((buttons & 2) ? ui::EF_RIGHT_MOUSE_BUTTON : 0) |
+         ((buttons & 4) ? ui::EF_MIDDLE_MOUSE_BUTTON : 0) |
+         ((buttons & 8) ? ui::EF_BACK_MOUSE_BUTTON : 0) |
+         ((buttons & 16) ? ui::EF_FORWARD_MOUSE_BUTTON : 0);
+}
+gfx::PointF Location(aura::WindowTreeHost* host, float x, float y) {
+  const auto size = host->window()->bounds().size();
+  return {std::clamp(x, 0.0f, 1.0f) * size.width(),
+          std::clamp(y, 0.0f, 1.0f) * size.height()};
+}
+}  // namespace
+
+RbInput::RbInput() = default;
+// The owner must ResetInput while roots are live, before destroying this
+// object.
+RbInput::~RbInput() = default;
+
+void RbInput::InjectMouse(aura::WindowTreeHost* host, ui::MouseEvent* event) {
+  gfx::PointF screen = event->location_f();
+  wm::ConvertPointToScreen(host->window(), &screen);
+  // M1 reuses the existing public virtual-point setter; this never calls Win32.
+  if (auto* screen_win = display::win::GetScreenWinHeadless()) {
+    screen_win->SetCursorScreenPointForTesting(gfx::ToRoundedPoint(screen));
+  }
+  if (auto* capture = views::DesktopCaptureClient::GetCaptureWindowGlobal()) {
+    host = capture->GetHost();
+    wm::ConvertPointFromScreen(host->window(), &screen);
+    event->set_location_f(screen);
+    event->set_root_location_f(screen);
+  }
+  aura::EventInjector().Inject(host, event);
+}
+
+void RbInput::Pointer(aura::WindowTreeHost* host,
+                        const mojom::PointerInput& input) {
+  if (!ui::IsRbRemoteMode() || !host || !std::isfinite(input.x) ||
+      !std::isfinite(input.y)) {
+    return;
+  }
+  if (input.type != mojom::PointerType::kMouse) {
+    Touch(host, input);
+    return;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  auto weak_host = host->GetWeakPtr();
+  const auto loc = Location(host, input.x, input.y);
+  mods_ = Modifiers(input.mods);
+  if (mouse_inside_ && mouse_host_ && mouse_host_.get() != host) {
+    ui::MouseEvent exit(ui::EventType::kMouseExited, mouse_location_,
+                        mouse_location_, input.timestamp, mods_ | buttons_, 0);
+    auto old_host = mouse_host_;
+    mouse_inside_ = false;
+    InjectMouse(old_host.get(), &exit);
+    if (!weak_this || !weak_host) {
+      return;
+    }
+  }
+  mouse_host_ = weak_host;
+  mouse_location_ = loc;
+  using Action = mojom::PointerAction;
+  if (input.action == Action::kCancel) {
+    ResetInput();
+    return;
+  }
+  if (input.action == Action::kLeave) {
+    mouse_inside_ = false;
+    ui::MouseEvent exit(ui::EventType::kMouseExited, loc, loc, input.timestamp,
+                        mods_ | buttons_, 0);
+    InjectMouse(host, &exit);
+    return;
+  }
+  if (!mouse_inside_) {
+    mouse_inside_ = true;
+    ui::MouseEvent enter(ui::EventType::kMouseEntered, loc, loc,
+                         input.timestamp, mods_ | buttons_, 0);
+    InjectMouse(host, &enter);
+    if (!weak_this || !weak_host) {
+      return;
+    }
+  }
+  const int changed = Button(input.button);
+  ui::EventType type = ui::EventType::kMouseMoved;
+  int flags = Buttons(input.buttons);
+  if (input.action == Action::kDown) {
+    if (!changed) {
+      return;
+    }
+    type = ui::EventType::kMousePressed;
+    const auto elapsed = input.timestamp - last_click_time_;
+    const bool repeat = last_click_button_ == changed &&
+                        !last_click_time_.is_null() && elapsed.is_positive() &&
+                        elapsed <= base::Milliseconds(::GetDoubleClickTime()) &&
+                        std::abs(loc.x() - last_click_location_.x()) <= 4 &&
+                        std::abs(loc.y() - last_click_location_.y()) <= 4;
+    click_count_ = repeat ? click_count_ % 3 + 1 : 1;
+    last_click_time_ = input.timestamp;
+    last_click_location_ = loc;
+    last_click_button_ = changed;
+    flags |= changed;
+    buttons_ = flags;
+  } else if (input.action == Action::kUp) {
+    if (!changed) {
+      return;
+    }
+    type = ui::EventType::kMouseReleased;
+    buttons_ = flags;
+    flags |= changed;  // Aura removes changed_button_flags on release.
+  } else {
+    flags = buttons_;
+    if (buttons_) {
+      type = ui::EventType::kMouseDragged;
+    }
+  }
+  ui::MouseEvent event(
+      type, loc, loc, input.timestamp, mods_ | flags,
+      type == ui::EventType::kMouseMoved || type == ui::EventType::kMouseDragged
+          ? 0
+          : changed);
+  if (type == ui::EventType::kMousePressed ||
+      type == ui::EventType::kMouseReleased) {
+    event.SetClickCount(std::max(1, click_count_));
+  }
+  InjectMouse(host, &event);
+}
+
+void RbInput::Wheel(aura::WindowTreeHost* host,
+                      const mojom::WheelInput& input) {
+  if (!ui::IsRbRemoteMode() || !host || !std::isfinite(input.x) ||
+      !std::isfinite(input.y) || !std::isfinite(input.dx) ||
+      !std::isfinite(input.dy)) {
+    return;
+  }
+  const auto loc = Location(host, input.x, input.y);
+  mods_ = Modifiers(input.mods);
+  // DOM positive deltas mean right/down; Aura offsets mean left/up.
+  gfx::Vector2d offset(
+      std::lround(-std::clamp(input.dx, -100000.0f, 100000.0f)),
+      std::lround(-std::clamp(input.dy, -100000.0f, 100000.0f)));
+  ui::MouseWheelEvent event(offset, loc, loc, input.timestamp, mods_ | buttons_,
+                            0);
+  InjectMouse(host, &event);
+}
+
+void RbInput::Touch(aura::WindowTreeHost* host,
+                      const mojom::PointerInput& input) {
+  if (input.pid == 0 || input.pid > 15 || !std::isfinite(input.radius_x) ||
+      !std::isfinite(input.radius_y) || !std::isfinite(input.pressure)) {
+    return;
+  }
+  using Action = mojom::PointerAction;
+  auto it = touches_.find(input.pid);
+  if ((input.action == Action::kDown) == (it != touches_.end())) {
+    return;  // No duplicate down or orphan move/up/cancel.
+  }
+  auto loc = Location(host, input.x, input.y);
+  ui::EventType type;
+  switch (input.action) {
+    case Action::kDown:
+      type = ui::EventType::kTouchPressed;
+      break;
+    case Action::kMove:
+      type = ui::EventType::kTouchMoved;
+      break;
+    case Action::kUp:
+      type = ui::EventType::kTouchReleased;
+      break;
+    case Action::kCancel:
+      type = ui::EventType::kTouchCancelled;
+      break;
+    case Action::kLeave:
+      return;  // Contact remains active until up/cancel/reset.
+  }
+  if (it != touches_.end()) {
+    if (!it->second.host) {
+      touches_.erase(it);
+      return;
+    }
+    if (it->second.host.get() != host) {
+      wm::ConvertPointToScreen(host->window(), &loc);
+      host = it->second.host.get();
+      wm::ConvertPointFromScreen(host->window(), &loc);
+    }
+  }
+  ui::PointerDetails details(
+      input.type == mojom::PointerType::kPen ? ui::EventPointerType::kPen
+                                             : ui::EventPointerType::kTouch,
+      input.pid, std::max(0.0f, input.radius_x), std::max(0.0f, input.radius_y),
+      std::clamp(input.pressure, 0.0f, 1.0f));
+  if (input.action == Action::kCancel) {
+    loc = it->second.location;
+    details = it->second.details;
+  }
+  if (input.action == Action::kUp || input.action == Action::kCancel) {
+    touches_.erase(input.pid);
+  } else {
+    touches_.insert_or_assign(input.pid,
+                              HeldTouch{host->GetWeakPtr(), loc, details});
+  }
+  mods_ = Modifiers(input.mods);
+  ui::TouchEvent event(type, loc, loc, input.timestamp, details, mods_);
+  aura::EventInjector().Inject(host, &event);
+}
+
+void RbInput::Key(aura::WindowTreeHost* host, const mojom::KeyInput& input) {
+  if (!ui::IsRbRemoteMode() || !host || input.code.size() > 32 ||
+      input.key.size() > 32 || input.key_code == 229) {
+    return;
+  }
+  const auto code = ui::KeycodeConverter::CodeStringToDomCode(input.code);
+  auto key = ui::KeycodeConverter::KeyStringToDomKey(input.key);
+  // KeyEvent::GetCharacter supports BMP only; supplementary text uses
+  // ImeCommit.
+  if (key.IsCharacter() && key.ToCharacter() > 0xffff) {
+    return;
+  }
+  if (key == ui::DomKey::NONE) {
+    key = ui::DomKey::UNIDENTIFIED;  // Never fall through to server layout
+                                     // lookup.
+  }
+  auto vkey = ui::DomCodeToUsLayoutKeyboardCode(code);
+  if (vkey == ui::VKEY_UNKNOWN) {
+    vkey = ui::NonPrintableDomKeyToKeyboardCode(key);
+  }
+  if (vkey == ui::VKEY_UNKNOWN && input.code.empty() && input.key_code <= 255) {
+    vkey = static_cast<ui::KeyboardCode>(input.key_code);
+  }
+  vkey = ui::LocatedToNonLocatedKeyboardCode(vkey);
+  mods_ = Modifiers(input.mods);
+  ui::KeyEvent event(
+      input.down ? ui::EventType::kKeyPressed : ui::EventType::kKeyReleased,
+      vkey, code, mods_ | (input.repeat ? ui::EF_IS_REPEAT : 0), key,
+      input.timestamp);
+  const std::string id = input.code.empty()
+                             ? "vk:" + std::to_string(static_cast<int>(vkey))
+                             : input.code;
+  if (input.down) {
+    keys_.insert_or_assign(id, HeldKey{host->GetWeakPtr(), event});
+  } else {
+    keys_.erase(id);
+  }
+  // Deliberately no EF_IS_SYNTHESIZED: RemoteInputMethod handles InsertChar.
+  aura::EventInjector().Inject(host, &event);
+}
+
+void RbInput::ResetInput() {
+  if (!ui::IsRbRemoteMode()) {
+    return;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  auto keys = std::exchange(keys_, {});
+  auto touches = std::exchange(touches_, {});
+  auto host = mouse_host_;
+  const auto loc = mouse_location_;
+  int held_buttons = std::exchange(buttons_, 0);
+  const auto now = base::TimeTicks::Now();
+  const bool had_mouse = std::exchange(mouse_inside_, false);
+  mods_ = 0;
+  last_click_time_ = base::TimeTicks();
+  for (int button : {0, 1, 2, 3, 4}) {
+    const int flag = Button(button);
+    if (host && (held_buttons & flag)) {
+      ui::MouseEvent event(ui::EventType::kMouseReleased, loc, loc, now,
+                           held_buttons, flag);
+      held_buttons &= ~flag;
+      InjectMouse(host.get(), &event);
+      if (!weak_this) {
+        return;
+      }
+    }
+  }
+  if (host && had_mouse) {
+    ui::MouseEvent exit(ui::EventType::kMouseExited, loc, loc, now, 0, 0);
+    InjectMouse(host.get(), &exit);
+    if (!weak_this) {
+      return;
+    }
+  }
+  for (const auto& [id, held] : keys) {
+    if (!held.host) {
+      continue;
+    }
+    ui::KeyEvent event(ui::EventType::kKeyReleased, held.event.key_code(),
+                       held.event.code(), 0, held.event.GetDomKey(), now);
+    aura::EventInjector().Inject(held.host.get(), &event);
+    if (!weak_this) {
+      return;
+    }
+  }
+  for (const auto& [id, held] : touches) {
+    if (!held.host) {
+      continue;
+    }
+    ui::TouchEvent event(ui::EventType::kTouchCancelled, held.location,
+                         held.location, now, held.details);
+    aura::EventInjector().Inject(held.host.get(), &event);
+    if (!weak_this) {
+      return;
+    }
+  }
+}
+}  // namespace rb
