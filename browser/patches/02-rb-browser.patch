+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RB_RB_DELEGATES_H_
+#define CHROME_BROWSER_RB_RB_DELEGATES_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/rb/mojom/rb.mojom.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+
+namespace rb {
+
+// UI-thread interfaces, implemented by the other M1 tasks. Delegates outlive
+// RbController. SetClient(nullptr) must detach observers without
+// dereferencing the previous proxy. Non-null SetClient sends the initial
+// window/IME snapshot.
+class RbWindowRegistryDelegate {
+ public:
+  virtual ~RbWindowRegistryDelegate() = default;
+  virtual void SetClient(mojom::RbBrowserClient* client) = 0;
+  virtual void ActivateWindow(uint32_t window_id) = 0;
+  virtual void Focus(bool focused) = 0;
+  virtual void NewWindow(const std::string& url) = 0;
+};
+
+class RbCaptureDelegate {
+ public:
+  virtual ~RbCaptureDelegate() = default;
+  virtual void FillHelloInfo(mojom::HelloInfo& info) = 0;
+  // Move sink to the capture sequence before binding; read kRbCaptureFps
+  // here.
+  virtual void StartCapture(uint32_t window_id,
+                            mojom::CaptureParamsPtr params,
+                            mojo::PendingRemote<mojom::RbFrameSink> sink) = 0;
+  virtual void StopCapture(uint32_t window_id) = 0;
+  virtual void RequestRefreshFrame(uint32_t window_id) = 0;
+  // Stop all captures; release pending frame callbacks even on IPC loss.
+  virtual void StopAll() = 0;
+};
+
+class RbInputDelegate {
+ public:
+  virtual ~RbInputDelegate() = default;
+  virtual void Pointer(uint32_t window_id, mojom::PointerInputPtr input) = 0;
+  virtual void Wheel(uint32_t window_id, mojom::WheelInputPtr input) = 0;
+  virtual void Key(uint32_t window_id, mojom::KeyInputPtr input) = 0;
+  virtual void ResetInput() = 0;
+};
+
+class RbImeBridgeDelegate {
+ public:
+  virtual ~RbImeBridgeDelegate() = default;
+  virtual void SetClient(mojom::RbBrowserClient* client) = 0;
+  virtual void ImeCommit(const std::string& text) = 0;
+  virtual void ImeCompose(const std::string& text, int32_t cursor) = 0;
+  virtual void ImeDelete(int32_t before, int32_t after) = 0;
+  virtual void Focus(bool focused) = 0;
+};
+
+// Null delegates deliberately allow a link-only spike with no window/capture
+// implementation. Integrators inject the four concrete delegates at creation.
+struct RbDelegates {
+  raw_ptr<RbWindowRegistryDelegate> windows = nullptr;
+  raw_ptr<RbCaptureDelegate> capture = nullptr;
+  raw_ptr<RbInputDelegate> input = nullptr;
+  raw_ptr<RbImeBridgeDelegate> ime = nullptr;
+};
+
+}  // namespace rb
+
+#endif  // CHROME_BROWSER_RB_RB_DELEGATES_H_
diff --git a/chrome/browser/rb/rb_ime_bridge.cc b/chrome/browser/rb/rb_ime_bridge.cc
new file mode 100644
index 0000000000..3ac67f3ea5
--- /dev/null
+++ b/chrome/browser/rb/rb_ime_bridge.cc
@@ -0,0 +1,285 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/rb/rb_ime_bridge.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ime/composition_text.h"
+#include "ui/base/ime/remote_input_method.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/base/ime/text_input_flags.h"
+#include "ui/base/ime/virtual_keyboard_controller.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/wm/core/coordinate_conversion.h"
+
+namespace rb {
+namespace {
+constexpr std::array<const char*, 18> kTypes = {
+    "none", "text", "password", "search",          "email",    "number",
+    "tel",  "url",  "date",     "datetime",        "datetime", "month",
+    "time", "week", "textarea", "contenteditable", "date",     "null"};
+static_assert(kTypes.size() == ui::TEXT_INPUT_TYPE_MAX + 1);
+constexpr std::array<const char*, 9> kModes = {"default", "none",    "text",
+                                               "tel",     "url",     "email",
+                                               "numeric", "decimal", "search"};
+static_assert(kModes.size() == ui::TEXT_INPUT_MODE_MAX + 1);
+// design/06 flags are a compact wire mask, not the ui::TextInputFlags bit
+// values.
+uint32_t WireFlags(int flags) {
+  constexpr std::array<int, 7> kFlags = {
+      ui::TEXT_INPUT_FLAG_AUTOCOMPLETE_OFF,
+      ui::TEXT_INPUT_FLAG_AUTOCORRECT_OFF,
+      ui::TEXT_INPUT_FLAG_SPELLCHECK_OFF,
+      ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_NONE,
+      ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_CHARACTERS,
+      ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_WORDS,
+      ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_SENTENCES};
+  uint32_t result = 0;
+  for (size_t i = 0; i < kFlags.size(); ++i) {
+    if (flags & kFlags[i]) {
+      result |= 1u << i;
+    }
+  }
+  return result;
+}
+const char* Reason(ui::TextInputClient::FocusReason reason) {
+  switch (reason) {
+    case ui::TextInputClient::FOCUS_REASON_NONE:
+      return "none";
+    case ui::TextInputClient::FOCUS_REASON_MOUSE:
+      return "mouse";
+    case ui::TextInputClient::FOCUS_REASON_TOUCH:
+      return "touch";
+    case ui::TextInputClient::FOCUS_REASON_PEN:
+      return "pen";
+    case ui::TextInputClient::FOCUS_REASON_OTHER:
+      return "other";
+  }
+  return "other";
+}
+bool DecodeText(const std::string& text, std::u16string* decoded) {
+  if (text.size() > 16384 || !base::IsStringUTF8(text)) {
+    return false;
+  }
+  *decoded = base::UTF8ToUTF16(text);
+  return decoded->size() <= 4096;
+}
+}  // namespace
+
+RbImeBridge::RbImeBridge(StateCallback state, KeyboardCallback keyboard)
+    : state_callback_(std::move(state)),
+      keyboard_callback_(std::move(keyboard)) {}
+RbImeBridge::~RbImeBridge() {
+  if (input_method_) {
+    input_method_->SetVirtualKeyboardCallback({});
+    input_method_->SetCompositionCancelledCallback({});
+    input_method_->RemoveObserver(this);
+  }
+}
+
+void RbImeBridge::SetActiveHost(aura::WindowTreeHost* host) {
+  if (!ui::IsRbRemoteMode()) {
+    return;
+  }
+  if (input_method_) {
+    input_method_->SetVirtualKeyboardCallback({});
+    input_method_->SetCompositionCancelledCallback({});
+    input_method_->RemoveObserver(this);
+  }
+  host_ = host ? host->GetWeakPtr() : nullptr;
+  // Factory selects RemoteInputMethod for every PRTS root. Do not replace it
+  // with a testing IME while this bridge is attached.
+  input_method_ =
+      host ? static_cast<ui::RemoteInputMethod*>(host->GetInputMethod())
+           : nullptr;
+  focused_ = host != nullptr;
+  ++context_;
+  if (input_method_) {
+    input_method_->AddObserver(this);
+    input_method_->SetVirtualKeyboardCallback(base::BindRepeating(
+        &RbImeBridge::OnKeyboard, weak_factory_.GetWeakPtr()));
+    input_method_->SetCompositionCancelledCallback(base::BindRepeating(
+        &RbImeBridge::OnCompositionCancelled, weak_factory_.GetWeakPtr()));
+  }
+  Publish();
+}
+
+ui::TextInputClient* RbImeBridge::EditableClient() const {
+  if (!ui::IsRbRemoteMode() || !host_ || !focused_ || !input_method_) {
+    return nullptr;
+  }
+  auto* client = input_method_->GetTextInputClient();
+  return client && client->GetTextInputType() != ui::TEXT_INPUT_TYPE_NONE
+             ? client
+             : nullptr;
+}
+
+void RbImeBridge::Publish() {
+  auto* client = EditableClient();
+  if (client != client_.get()) {
+    client_ = client ? client->AsWeakPtr() : nullptr;
+    ++context_;
+  }
+  auto state = mojom::ImeState::New();
+  state->seq = ++seq_;
+  state->context = context_;
+  state->focused = false;
+  state->type = "none";
+  state->mode = "default";
+  state->flags = 0;
+  state->reason = "none";
+  if (client) {
+    state->focused = true;
+    const size_t type = static_cast<size_t>(client->GetTextInputType());
+    const size_t mode = static_cast<size_t>(client->GetTextInputMode());
+    state->type = type < kTypes.size() ? kTypes[type] : "none";
+    state->mode = mode < kModes.size() ? kModes[mode] : "default";
+    state->flags = WireFlags(client->GetTextInputFlags());
+    state->reason = Reason(client->GetFocusReason());
+    state->composing = client->HasCompositionText();
+    gfx::Rect caret = client->GetCaretBounds();
+    wm::ConvertRectFromScreen(host_->window(), &caret);
+    const auto size = host_->window()->bounds().size();
+    if (!size.IsEmpty()) {
+      // Collapsed renderer carets can have zero width. Rect::Intersect would
+      // erase their position; clamp edges independently instead.
+      const int x = std::clamp(caret.x(), 0, size.width());
+      const int y = std::clamp(caret.y(), 0, size.height());
+      const int right = std::clamp(caret.right(), x, size.width());
+      const int bottom = std::clamp(caret.bottom(), y, size.height());
+      state->caret_norm =
+          gfx::RectF(static_cast<float>(x) / size.width(),
+                     static_cast<float>(y) / size.height(),
+                     static_cast<float>(right - x) / size.width(),
+                     static_cast<float>(bottom - y) / size.height());
+    }
+  }
+  // Copy callbacks before invoking embedder code, which may destroy the bridge.
+  auto state_callback = state_callback_;
+  auto keyboard_callback = keyboard_callback_;
+  const bool hide = !state->focused || state->mode == "none";
+  // State precedes its visibility decision; every message has a unique seq.
+  const uint32_t hide_seq = hide ? ++seq_ : 0;
+  if (state_callback) {
+    state_callback.Run(std::move(state));
+  }
+  if (hide && keyboard_callback) {
+    keyboard_callback.Run(false, hide_seq);
+  }
+}
+
+void RbImeBridge::OnKeyboard(bool show) {
+  auto* client = EditableClient();
+  show =
+      show && client && client->GetTextInputMode() != ui::TEXT_INPUT_MODE_NONE;
+  if (keyboard_callback_) {
+    keyboard_callback_.Run(show, ++seq_);
+  }
+}
+void RbImeBridge::OnCompositionCancelled() {
+  if (!ui::IsRbRemoteMode()) {
+    return;
+  }
+  // Cancellation also marks node/selection changes on the same Aura client.
+  // Reject any older in-flight edits rather than applying them to the new node.
+  ++context_;
+  Publish();
+}
+void RbImeBridge::OnFocus() {
+  focused_ = true;
+  Publish();
+}
+void RbImeBridge::OnBlur() {
+  focused_ = false;
+  Publish();
+}
+void RbImeBridge::OnCaretBoundsChanged(const ui::TextInputClient* client) {
+  if (input_method_ && client == input_method_->GetTextInputClient()) {
+    Publish();
+  }
+}
+void RbImeBridge::OnTextInputStateChanged(const ui::TextInputClient* client) {
+  if (input_method_ && client == input_method_->GetTextInputClient()) {
+    Publish();
+  }
+}
+void RbImeBridge::OnInputMethodDestroyed(
+    const ui::InputMethod* input_method) {
+  // MockInputMethod's destructor sends this after the derived object is gone.
+  // Never call a RemoteInputMethod method from this callback.
+  input_method_ = nullptr;
+  host_.reset();
+  focused_ = false;
+  Publish();
+}
+
+void RbImeBridge::ImeCommit(const std::string& text, uint32_t context) {
+  if (context && context != context_) {
+    return;
+  }
+  std::u16string decoded;
+  if (!DecodeText(text, &decoded)) {
+    return;
+  }
+  if (auto* client = EditableClient()) {
+    client->InsertText(
+        decoded,
+        ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+  }
+}
+void RbImeBridge::ImeCompose(const std::string& text,
+                               int32_t cursor,
+                               uint32_t context) {
+  if (context && context != context_) {
+    return;
+  }
+  ui::CompositionText composition;
+  if (!DecodeText(text, &composition.text)) {
+    return;
+  }
+  auto* client = EditableClient();
+  if (!client) {
+    return;
+  }
+  if (composition.text.empty()) {
+    client->ClearCompositionText();
+    return;
+  }
+  const size_t offset = std::clamp<int32_t>(
+      cursor, 0, static_cast<int32_t>(composition.text.size()));
+  composition.selection = gfx::Range(offset);
+  composition.ime_text_spans.emplace_back(ui::ImeTextSpan::Type::kComposition,
+                                          0, composition.text.size());
+  client->SetCompositionText(composition);
+}
+void RbImeBridge::ImeDelete(int32_t before, int32_t after, uint32_t context) {
+  if (context && context != context_) {
+    return;
+  }
+  if (before < 0 || after < 0 || before > 4096 || after > 4096) {
+    return;
+  }
+  if (auto* client = EditableClient()) {
+    client->ExtendSelectionAndDelete(before, after);
+  }
+}
+void RbImeBridge::ImeHidden(uint32_t context) {
+  if (context && context != context_) {
+    return;
+  }
+  // Keep the content VK helper's observer state coherent so a subsequent tap
+  // can request another show without changing the remote editable focus.
+  if (ui::IsRbRemoteMode() && input_method_) {
+    input_method_->GetVirtualKeyboardController()->DismissVirtualKeyboard();
+  }
+}
+}  // namespace rb
