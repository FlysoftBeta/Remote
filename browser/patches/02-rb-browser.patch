@@ -0,0 +1,209 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/rb/rb_cursor_bridge.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/strings/string_number_conversions.h"
+#include "skia/ext/image_operations.h"
+#include "ui/aura/client/cursor_client.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace rb {
+namespace {
+
+std::string CustomCss(const ui::Cursor& cursor) {
+  const SkBitmap& source = cursor.custom_bitmap();
+  if (source.drawsNothing()) {
+    return "default";
+  }
+  // CSS cursor images and hotspots use CSS pixels, not source image pixels.
+  const float image_scale = cursor.image_scale_factor();
+  if (!std::isfinite(image_scale) || image_scale <= 0) {
+    return "default";
+  }
+  float scale = std::min(1.0f / image_scale,
+                         128.0f / std::max(source.width(), source.height()));
+  // Keep the complete JSON message below 64 KiB, including base64 overhead.
+  for (int attempt = 0; attempt < 2; ++attempt, scale *= 0.5f) {
+    const int width = std::clamp(
+        static_cast<int>(std::lround(source.width() * scale)), 1, 128);
+    const int height = std::clamp(
+        static_cast<int>(std::lround(source.height() * scale)), 1, 128);
+    SkBitmap bitmap = skia::ImageOperations::Resize(
+        source, skia::ImageOperations::RESIZE_BEST, width, height);
+    auto png = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false);
+    if (!png) {
+      return "default";
+    }
+    if (png->size() > 45000) {
+      continue;
+    }
+    const auto& hotspot = cursor.custom_hotspot();
+    const int x = std::clamp(
+        static_cast<int>(std::lround(hotspot.x() * static_cast<float>(width) /
+                                     source.width())),
+        0, width - 1);
+    const int y = std::clamp(
+        static_cast<int>(std::lround(hotspot.y() * static_cast<float>(height) /
+                                     source.height())),
+        0, height - 1);
+    return "url(data:image/png;base64," + base::Base64Encode(*png) + ") " +
+           base::NumberToString(x) + " " + base::NumberToString(y) + ", auto";
+  }
+  return "default";
+}
+
+std::string CursorCss(const ui::Cursor& cursor) {
+  using Type = ui::mojom::CursorType;
+  switch (cursor.type()) {
+    case Type::kNull:
+    case Type::kPointer:
+      return "default";
+    case Type::kCross:
+      return "crosshair";
+    case Type::kHand:
+      return "pointer";
+    case Type::kIBeam:
+      return "text";
+    case Type::kWait:
+      return "wait";
+    case Type::kHelp:
+      return "help";
+    case Type::kEastResize:
+    case Type::kEastPanning:
+      return "e-resize";
+    case Type::kNorthResize:
+    case Type::kNorthPanning:
+      return "n-resize";
+    case Type::kNorthEastResize:
+    case Type::kNorthEastPanning:
+      return "ne-resize";
+    case Type::kNorthWestResize:
+    case Type::kNorthWestPanning:
+      return "nw-resize";
+    case Type::kSouthResize:
+    case Type::kSouthPanning:
+      return "s-resize";
+    case Type::kSouthEastResize:
+    case Type::kSouthEastPanning:
+      return "se-resize";
+    case Type::kSouthWestResize:
+    case Type::kSouthWestPanning:
+      return "sw-resize";
+    case Type::kWestResize:
+    case Type::kWestPanning:
+      return "w-resize";
+    case Type::kNorthSouthResize:
+    case Type::kMiddlePanningVertical:
+      return "ns-resize";
+    case Type::kEastWestResize:
+    case Type::kMiddlePanningHorizontal:
+      return "ew-resize";
+    case Type::kNorthEastSouthWestResize:
+      return "nesw-resize";
+    case Type::kNorthWestSouthEastResize:
+      return "nwse-resize";
+    case Type::kColumnResize:
+      return "col-resize";
+    case Type::kRowResize:
+      return "row-resize";
+    case Type::kMiddlePanning:
+    case Type::kMove:
+    case Type::kDndMove:
+      return "move";
+    case Type::kVerticalText:
+      return "vertical-text";
+    case Type::kCell:
+      return "cell";
+    case Type::kContextMenu:
+      return "context-menu";
+    case Type::kAlias:
+    case Type::kDndLink:
+      return "alias";
+    case Type::kProgress:
+      return "progress";
+    case Type::kNoDrop:
+    case Type::kDndNone:
+      return "no-drop";
+    case Type::kCopy:
+    case Type::kDndCopy:
+      return "copy";
+    case Type::kNone:
+      return "none";
+    case Type::kNotAllowed:
+    case Type::kEastWestNoResize:
+    case Type::kNorthSouthNoResize:
+    case Type::kNorthEastSouthWestNoResize:
+    case Type::kNorthWestSouthEastNoResize:
+      return "not-allowed";
+    case Type::kZoomIn:
+      return "zoom-in";
+    case Type::kZoomOut:
+      return "zoom-out";
+    case Type::kGrab:
+      return "grab";
+    case Type::kGrabbing:
+      return "grabbing";
+    case Type::kCustom:
+      return CustomCss(cursor);
+  }
+  return "default";
+}
+
+}  // namespace
+
+RbCursorBridge::RbCursorBridge(
+    base::RepeatingCallback<void(const std::string&)> send)
+    : send_(std::move(send)) {
+  if (ui::IsRbRemoteMode()) {
+    views::RemoteCursorSink::SetInstance(this);
+  }
+}
+
+RbCursorBridge::~RbCursorBridge() {
+  if (views::RemoteCursorSink::GetInstance() == this) {
+    views::RemoteCursorSink::SetInstance(nullptr);
+  }
+}
+
+void RbCursorBridge::SetActiveHost(aura::WindowTreeHost* host) {
+  host_ = host ? host->GetWeakPtr() : nullptr;
+  last_cursor_.reset();
+  last_css_.clear();
+  if (host_) {
+    auto* client = aura::client::GetCursorClient(host_->window());
+    ui::Cursor cursor(ui::mojom::CursorType::kPointer);
+    if (client) {
+      cursor = client->IsCursorVisible()
+                   ? client->GetCursor()
+                   : ui::Cursor(ui::mojom::CursorType::kNone);
+    }
+    OnCursorChanged(host_->window(), cursor);
+  }
+}
+
+void RbCursorBridge::OnCursorChanged(aura::Window* root,
+                                       const ui::Cursor& cursor) {
+  if (!ui::IsRbRemoteMode() || !host_ || root != host_->window() ||
+      (last_cursor_ && *last_cursor_ == cursor)) {
+    return;
+  }
+  last_cursor_ = cursor;
+  std::string css = CursorCss(cursor);
+  if (css == last_css_) {
+    return;
+  }
+  last_css_ = css;
+  auto send = send_;
+  send.Run(css);
+}
+
+}  // namespace rb
