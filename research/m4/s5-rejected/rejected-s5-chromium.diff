new file mode 100644
--- /dev/null
+++ b/chrome/browser/prts/prts_frame_pacer.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prts/prts_frame_pacer.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace prts {
+
+PrtsFramePacer::PrtsFramePacer(ui::Compositor* compositor,
+                               uint64_t generation,
+                               base::TimeDelta interval)
+    : generation_(generation), interval_(interval) {
+  observation_.Observe(compositor);
+  LOG(INFO) << "PRTS pacer gen=" << generation_
+            << " sid=" << source_->source_id();
+}
+
+PrtsFramePacer::~PrtsFramePacer() {
+  if (pending_) {
+    std::move(pending_).Run(false, false);
+  }
+}
+
+void PrtsFramePacer::OnCompositingShuttingDown(ui::Compositor* compositor) {
+  observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+  if (pending_) {
+    std::move(pending_).Run(false, false);
+  }
+}
+
+bool PrtsFramePacer::Recover() {
+  if (!observation_.IsObserving()) {
+    return false;
+  }
+  // Old callbacks must not complete the replacement controller's transaction.
+  weak_factory_.InvalidateWeakPtrs();
+  auto* compositor = observation_.GetSource();
+  const bool was_visible = compositor->IsVisible();
+  compositor->SetVisible(false);
+  const auto widget = compositor->ReleaseAcceleratedWidget();
+  compositor->SetAcceleratedWidget(widget);
+  compositor->SetVisible(was_visible);
+  compositor->ScheduleFullRedraw();
+  source_ = std::make_unique<viz::StubBeginFrameSource>();
+  if (pending_) {
+    // The old controller has actually been destroyed, not synthetically ACKed.
+    std::move(pending_).Run(false, false);
+  }
+  LOG(WARNING) << "PRTS pacer recreated gen=" << generation_
+               << " sid=" << source_->source_id();
+  return true;
+}
+
+void PrtsFramePacer::Tick(uint64_t sequence,
+                          base::TimeTicks time,
+                          mojom::PrtsBrowser::PaceTickCallback reply) {
+  const auto now = base::TimeTicks::Now();
+  if (!observation_.IsObserving() || pending_ || sequence <= sequence_ ||
+      time <= last_time_ || time > now + interval_ || now >= time + interval_ * 0.8 ||
+      (!last_time_.is_null() && time - last_time_ < base::Milliseconds(4))) {
+    std::move(reply).Run(false, false);
+    return;
+  }
+  sequence_ = sequence;
+  last_time_ = time;
+  pending_ = std::move(reply);
+  // Sequence numbers never reset during a root generation.
+  auto args = viz::BeginFrameArgs::Create(
+      BEGINFRAME_FROM_HERE, source_->source_id(), sequence, time,
+      time + interval_ * 0.8, interval_, viz::BeginFrameArgs::NORMAL);
+  observation_.GetSource()->IssueExternalBeginFrame(
+      args, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                base::BindOnce(&PrtsFramePacer::OnAck,
+                               weak_factory_.GetWeakPtr(), sequence),
+                viz::BeginFrameAck()));
+}
+
+void PrtsFramePacer::OnAck(uint64_t sequence, const viz::BeginFrameAck& ack) {
+  if (!pending_ || sequence != sequence_) {
+    return;
+  }
+  const bool valid = ack.frame_id.sequence_number == sequence &&
+                     ack.frame_id.source_id == source_->source_id();
+  std::move(pending_).Run(valid, valid && ack.has_damage);
+}
+
+}  // namespace prts
