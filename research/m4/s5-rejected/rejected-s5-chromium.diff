+
+#ifndef CHROME_BROWSER_PRTS_PRTS_FRAME_PACER_H_
+#define CHROME_BROWSER_PRTS_PRTS_FRAME_PACER_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/prts/mojom/prts.mojom.h"
+#include "components/viz/common/frame_sinks/begin_frame_args.h"
+#include "components/viz/common/frame_sinks/begin_frame_source.h"
+#include "ui/compositor/compositor.h"
+#include "ui/compositor/compositor_observer.h"
+
+namespace prts {
+
+// UI-thread, one per root. A display ACK is not a capture/GPU completion.
+class PrtsFramePacer : public ui::CompositorObserver {
+ public:
+  PrtsFramePacer(ui::Compositor* compositor,
+                 uint64_t generation,
+                 base::TimeDelta interval);
+  ~PrtsFramePacer() override;
+  uint64_t generation() const { return generation_; }
+  bool Recover();
+  void Tick(uint64_t sequence,
+            base::TimeTicks time,
+            mojom::PrtsBrowser::PaceTickCallback reply);
+
+ private:
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
+  void OnAck(uint64_t sequence, const viz::BeginFrameAck& ack);
+  const uint64_t generation_;
+  const base::TimeDelta interval_;
+  // Allocate a unique source ID from the browser process source namespace.
+  std::unique_ptr<viz::StubBeginFrameSource> source_ =
+      std::make_unique<viz::StubBeginFrameSource>();
+  uint64_t sequence_ = 0;
+  base::TimeTicks last_time_;
+  mojom::PrtsBrowser::PaceTickCallback pending_;
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver> observation_{
+      this};
+  base::WeakPtrFactory<PrtsFramePacer> weak_factory_{this};
+};
+
+}  // namespace prts
+#endif  // CHROME_BROWSER_PRTS_PRTS_FRAME_PACER_H_
