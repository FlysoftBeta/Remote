+  auto it = pacers_.find(window_id);
+  if (it == pacers_.end() || it->second->generation() != generation) {
+    std::move(reply).Run(false, false);
+    return;
+  }
+  it->second->Tick(tick_seq, frame_time, std::move(reply));
+}
+
+void PrtsController::PaceReset(uint32_t window_id, uint64_t generation,
+                               PaceResetCallback reply) {
+  auto it = pacers_.find(window_id);
+  std::move(reply).Run(it != pacers_.end() &&
+                       it->second->generation() == generation &&
+                       it->second->Recover());
+}
